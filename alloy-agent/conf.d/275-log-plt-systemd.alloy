// Logs
// Collector (journal)
loki.source.journal "systemd" {
  forward_to    = [loki.relabel.systemd_transform.receiver]
  matches       = "SYSLOG_IDENTIFIER=systemd"
  relabel_rules = loki.relabel.systemd_journal_labels.rules
}

loki.relabel "systemd_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }
}

// Transformer (relabel)
loki.relabel "systemd_transform" {
  forward_to = [loki.process.systemd_normalize.receiver]

  rule {
    source_labels = ["priority"]
    regex         = "[012]"
    target_label  = "level"
    replacement   = "critical"
  }

  rule {
    source_labels = ["priority"]
    regex         = "3"
    target_label  = "level"
    replacement   = "error"
  }

  rule {
    source_labels = ["priority"]
    regex         = "[45]"
    target_label  = "level"
    replacement   = "warn"
  }

  rule {
    source_labels = ["priority"]
    regex         = "6"
    target_label  = "level"
    replacement   = "info"
  }

  rule {
    source_labels = ["priority"]
    regex         = "7"
    target_label  = "level"
    replacement   = "debug"
  }

  rule {
    source_labels = ["level"]
    regex         = "^$"
    target_label  = "level"
    replacement   = "unknown"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }

  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }

  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// Transformer (process)
// Nota: systemd gera volume alto de eventos de ciclo de vida de units (priority=6).
//       Para capturar apenas falhas, altere o selector para `{priority=~"5|6|7"}`.
loki.process "systemd_normalize" {
  forward_to = [
    // loki.echo.systemd_debug.receiver,
    loki.write.systemd_gateway.receiver,
  ]

  stage.match {
    selector = `{level=~"info|debug"}`
    action   = "drop"
  }

  stage.label_drop {
    values = ["priority", "job"]
  }

  stage.static_labels {
    values = {
      category     = "platform",
      service_name = "systemd",
    }
  }
}

// Debug
loki.echo "systemd_debug" { }

// Writer (endpoint)
loki.write "systemd_gateway" {
  endpoint { url = "http://alloy-gateway:9998/loki/api/v1/push" }
}

// =============================================================================
// LOGS — Platform / systemd
// =============================================================================
// Pipeline: journal -> systemd_filters -> severity_normalizer -> log_standardizer -> global_identity
// =============================================================================

loki.source.journal "systemd" {
  forward_to = [
    loki.process.systemd_filters.receiver,
  ]

  matches       = "SYSLOG_IDENTIFIER=systemd"
  relabel_rules = loki.relabel.systemd_journal_labels.rules
}


loki.relabel "systemd_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  rule {
    target_label = "category"
    replacement  = "platform"
  }

  rule {
    target_label = "service_name"
    replacement  = "systemd"
  }
}


loki.process "systemd_filters" {
  forward_to = [
    loki.relabel.severity_normalizer.receiver,
  ]

  // Noise reduction: Drop info/debug to reduce noise from unit lifecycle events
  stage.match {
    selector = `{priority=~"6|7"}`
    action   = "drop"
  }
}
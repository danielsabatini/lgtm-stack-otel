// =============================================================================
// GLOBAL METRICS — Identity Labels & Gateway Endpoint
// =============================================================================
//
// exporters
//   -> host_info_extractor
//   -> global_identity
//   -> remote_write
//
// Global labels:
// - instance
// - environment
// - cloud_provider
// - cloud_region
// - cloud_availability_zone
//
// Derived metadata:
// - os
// - architecture
// - kernel
// - os_product
// - os_version
// =============================================================================



// =============================================================================
// HOST INFO EXTRACTION
// =============================================================================

prometheus.relabel "host_info_extractor" {

  forward_to = [
    prometheus.relabel.global_identity_node.receiver,
  ]


  // ---------------------------------------------------------------------------
  // node_uname_info -> os
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__", "sysname"]
    regex         = "node_uname_info;(.*)"
    target_label  = "os"
    replacement   = "$1"
  }

  rule {
    source_labels = ["os"]
    target_label  = "os"
    action        = "lowercase"
  }


  // ---------------------------------------------------------------------------
  // node_uname_info -> architecture
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__", "machine"]
    regex         = "node_uname_info;(.*)"
    target_label  = "architecture"
    replacement   = "$1"
  }


  // ---------------------------------------------------------------------------
  // node_uname_info -> kernel
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__", "release"]
    regex         = "node_uname_info;(.*)"
    target_label  = "kernel"
    replacement   = "$1"
  }


  // ---------------------------------------------------------------------------
  // node_os_info -> os_product
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__", "name"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }


  // ---------------------------------------------------------------------------
  // node_os_info -> os_version
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__", "version_id"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}




// =============================================================================
// GLOBAL IDENTITY — SPECIFIC
// =============================================================================

prometheus.relabel "global_identity_node" {
  forward_to = [prometheus.relabel.global_identity_shared.receiver]

  rule {
    target_label = "instance"
    replacement  = "lgtm-stack-node"
  }
}


prometheus.relabel "global_identity_container" {
  forward_to = [prometheus.relabel.global_identity_shared.receiver]

  rule {
    target_label = "instance"
    replacement  = "lgtm-stack-container"
  }
}




// =============================================================================
// GLOBAL IDENTITY — SHARED
// =============================================================================

prometheus.relabel "global_identity_shared" {

  forward_to = [
    prometheus.remote_write.gateway.receiver,
  ]


  // Environment
  rule {
    target_label = "environment"
    replacement  = "prd"
  }


  // Cloud Metadata
  rule {
    target_label = "cloud_provider"
    replacement  = "mgc"
  }

  rule {
    target_label = "cloud_region"
    replacement  = "br-se1"
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = "a"
  }
}



// =============================================================================
// OUTPUT
// =============================================================================

prometheus.remote_write "gateway" {
  endpoint {
    url = "http://alloy-gateway:9999/api/v1/metrics/write"
  }
}



// =============================================================================
// DEBUG
// =============================================================================

prometheus.echo "debug" {
  format = "text"
}
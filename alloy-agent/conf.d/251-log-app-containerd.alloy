// =============================================================================
// LOGS — Application / containerd
// =============================================================================
// Pipeline: journal -> containerd_filters -> severity_normalizer -> log_standardizer -> global_identity
// =============================================================================

loki.source.journal "containerd" {
  forward_to = [
    loki.process.containerd_filters.receiver,
  ]

  matches       = "_SYSTEMD_UNIT=containerd.service"
  relabel_rules = loki.relabel.containerd_journal_labels.rules
}


loki.relabel "containerd_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  rule {
    target_label = "category"
    replacement  = "application"
  }

  rule {
    target_label = "service_name"
    replacement  = "containerd"
  }
}


loki.process "containerd_filters" {
  forward_to = [
    loki.relabel.severity_normalizer.receiver,
  ]

  // Noise reduction: Drop info/debug
  stage.match {
    selector = `{priority=~"6|7"}`
    action   = "drop"
  }
}
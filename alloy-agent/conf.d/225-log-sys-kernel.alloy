// =============================================================================
// LOGS — System / Kernel
// =============================================================================
// Pipeline: journal -> kernel_filters -> severity_normalizer -> log_standardizer -> global_identity
// =============================================================================

loki.source.journal "kernel" {
  forward_to = [
    loki.process.kernel_filters.receiver,
  ]

  matches       = "_TRANSPORT=kernel"
  relabel_rules = loki.relabel.kernel_journal_labels.rules
}


loki.relabel "kernel_journal_labels" {
  forward_to = []

  // Extract priority for filtering and normalization
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  // Metadata
  rule {
    target_label = "category"
    replacement  = "system"
  }

  rule {
    target_label = "service_name"
    replacement  = "kernel"
  }
}


loki.process "kernel_filters" {
  forward_to = [
    loki.relabel.severity_normalizer.receiver,
  ]

  // Noise reduction: Drop low-value kernel events (info/debug)
  stage.match {
    selector = `{priority=~"6|7"}`
    action   = "drop"
  }
}
// =============================================================================
// LOGS — Application / Containers
// =============================================================================
// Pipeline: discovery.docker -> loki.source.docker -> loki.process -> global_identity_container
// =============================================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}


loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  forward_to    = [loki.process.containers_normalize.receiver]
  relabel_rules = loki.relabel.containers_labels.rules
}


loki.relabel "containers_labels" {
  forward_to = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}


loki.process "containers_normalize" {
  forward_to = [loki.relabel.global_identity_container.receiver]

  stage.logfmt {
    mapping = { "level" = "" }
  }

  stage.template {
    source   = "level"
    template = "{{ if .Value }}{{ .Value }}{{ else }}unknown{{ end }}"
  }

  stage.labels {
    values = { "level" = "" }
  }

  // Noise reduction: Drop low-value container logs
  stage.match {
    selector = `{level=~"info|debug"}`
    action   = "drop"
  }

  stage.static_labels {
    values = {
      category     = "application",
      service_name = "containers",
    }
  }
}
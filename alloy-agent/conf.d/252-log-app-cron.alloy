// =============================================================================
// LOGS — Application / Cron
// =============================================================================
// Pipeline: journal -> cron_filters -> severity_normalizer -> log_standardizer -> global_identity
// =============================================================================

loki.source.journal "cron" {
  forward_to = [
    loki.process.cron_filters.receiver,
  ]

  matches =
    "_SYSTEMD_UNIT=cron.service " +
    "_SYSTEMD_UNIT=crond.service"

  relabel_rules = loki.relabel.cron_journal_labels.rules
}


loki.relabel "cron_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  rule {
    target_label = "category"
    replacement  = "application"
  }

  rule {
    target_label = "service_name"
    replacement  = "cron"
  }
}


loki.process "cron_filters" {
  forward_to = [
    loki.relabel.severity_normalizer.receiver,
  ]

  // Noise reduction: Drop info/debug
  stage.match {
    selector = `{priority=~"6|7"}`
    action   = "drop"
  }
}
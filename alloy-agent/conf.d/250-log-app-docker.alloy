// Logs
// Collector (journal)
loki.source.journal "docker" {
  forward_to     = [loki.relabel.docker_transform.receiver]
  matches        = "_SYSTEMD_UNIT=docker.service"
  relabel_rules  = loki.relabel.docker_journal_labels.rules
}

loki.relabel "docker_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }
}

// Transformer (relabel)
loki.relabel "docker_transform" {
  forward_to = [loki.process.docker_normalize.receiver]

  rule {
    source_labels = ["priority"]
    regex         = "[012]"
    target_label  = "level"
    replacement   = "critical"
  }

  rule {
    source_labels = ["priority"]
    regex         = "3"
    target_label  = "level"
    replacement   = "error"
  }

  rule {
    source_labels = ["priority"]
    regex         = "[45]"
    target_label  = "level"
    replacement   = "warn"
  }

  rule {
    source_labels = ["priority"]
    regex         = "6"
    target_label  = "level"
    replacement   = "info"
  }

  rule {
    source_labels = ["priority"]
    regex         = "7"
    target_label  = "level"
    replacement   = "debug"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }

  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }

  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// Transformer (process)
loki.process "docker_normalize" {
  forward_to = [
    // loki.echo.docker_debug.receiver,
    loki.write.docker_gateway.receiver,
  ]

  stage.match {
    selector = `{level=~"info|debug"}`
    action   = "drop"
  }
  
  stage.label_drop {
    values = ["priority", "job"]
  }

  stage.static_labels {
    values = {
      category = "application",
      service_name = "docker",
    }
  }
}

// Debug
loki.echo "docker_debug" { }

// Writer (endpoint)
loki.write "docker_gateway" {
  endpoint { url = "http://alloy-gateway:9998/loki/api/v1/push" }
}
// =============================================================================
// LOGS — Application / Container Engine
// =============================================================================
// Pipeline: journal -> engine_filters -> severity_normalizer -> log_standardizer -> global_identity
// =============================================================================

loki.source.journal "container_engine" {
  forward_to = [
    loki.process.engine_filters.receiver,
  ]

  matches       = "_SYSTEMD_UNIT=docker.service"
  relabel_rules = loki.relabel.container_engine_journal_labels.rules
}


loki.relabel "container_engine_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  rule {
    target_label = "category"
    replacement  = "application"
  }

  rule {
    target_label = "service_name"
    replacement  = "container-engine"
  }
}


loki.process "engine_filters" {
  forward_to = [
    loki.relabel.severity_normalizer.receiver,
  ]

  // Noise reduction: Drop low-value engine events (info/debug)
  stage.match {
    selector = `{priority=~"6|7"}`
    action   = "drop"
  }
}
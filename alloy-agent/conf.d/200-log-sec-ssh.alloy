// =============================================================================
// LOGS — Security / SSH
// =============================================================================
// Pipeline: journal -> severity_normalizer -> log_standardizer -> global_identity
// =============================================================================

loki.source.journal "ssh" {
  forward_to = [
    loki.relabel.severity_normalizer.receiver,
  ]

  matches =
    "_SYSTEMD_UNIT=ssh.service " +
    "_SYSTEMD_UNIT=sshd.service"

  relabel_rules = loki.relabel.ssh_journal_labels.rules
}


loki.relabel "ssh_journal_labels" {
  forward_to = []

  // Extract priority for normalization
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  // Metadata
  rule {
    target_label = "category"
    replacement  = "security"
  }

  rule {
    target_label = "service_name"
    replacement  = "ssh"
  }
}
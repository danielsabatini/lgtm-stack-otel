// =============================================================================
// METRICS — Containers Local (cAdvisor)
// =============================================================================
// Pipeline: cadvisor_exporter -> scrape -> container_filter -> global_identity_container
// =============================================================================

prometheus.exporter.cadvisor "container_local" {
  docker_host = "unix:///var/run/docker.sock"
}


prometheus.scrape "container_local_scrape" {
  targets    = prometheus.exporter.cadvisor.container_local.targets
  forward_to = [prometheus.relabel.container_local_transformer.receiver]

  scrape_interval = "30s"
  scrape_timeout  = "10s"
}


prometheus.relabel "container_local_transformer" {
  forward_to = [
    prometheus.relabel.global_identity_container.receiver,
  ]

  // ---------------------------------------------------------------------------
  // METRICS SELECTION (Keep list)
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex =
      "container_(" +
        "cpu_usage_seconds_total|" +
        "cpu_cfs_periods_total|" +
        "cpu_cfs_throttled_periods_total|" +
        "memory_usage_bytes|" +
        "memory_working_set_bytes|" +
        "network_receive_bytes_total|" +
        "network_transmit_bytes_total|" +
        "fs_usage_bytes|" +
        "last_seen|" +
        "oom_events_total" +
      ")"
  }


  // ---------------------------------------------------------------------------
  // LABEL CLEANUP
  // ---------------------------------------------------------------------------

  // Drop OCI / Docker / cAdvisor metadata
  rule {
    action = "labeldrop"
    regex  = "container_label_.+|id|image|cpu"
  }

  // Normalize labels (name -> container)
  rule {
    source_labels = ["name"]
    target_label  = "container"
  }

  rule {
    action = "labeldrop"
    regex  = "name"
  }

  // Common Labels
  rule {
    target_label = "service_name"
    replacement  = "cadvisor-exporter"
  }
}
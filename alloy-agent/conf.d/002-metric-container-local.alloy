// =============================================================================
// METRICS — Containers Local (cAdvisor)
// =============================================================================
// Pipeline: cadvisor_exporter -> scrape -> container_filter -> global_identity_container
// =============================================================================

prometheus.exporter.cadvisor "container_local" {
  docker_host = "unix:///var/run/docker.sock"
}


prometheus.scrape "container_local_scrape" {
  targets    = prometheus.exporter.cadvisor.container_local.targets
  forward_to = [prometheus.relabel.container_local_transformer.receiver]

  scrape_interval = "30s"
  scrape_timeout  = "10s"
}


prometheus.relabel "container_local_transformer" {
  forward_to = [
    prometheus.relabel.global_identity_container.receiver,
  ]

  // ---------------------------------------------------------------------------
  // METRICS SELECTION (Keep list)
  // ---------------------------------------------------------------------------
  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // CPU
      "container_cpu_usage_seconds_total|" +
      "container_cpu_cfs_periods_total|" +
      "container_cpu_cfs_throttled_periods_total|" +

      // Memory
      "container_memory_working_set_bytes|" +
      "container_memory_usage_bytes|" +
      "container_oom_events_total|" +

      // Network
      "container_network_receive_bytes_total|" +
      "container_network_transmit_bytes_total"
  }



  // ---------------------------------------------------------------------------
  // LABEL CLEANUP & FILTERING
  // ---------------------------------------------------------------------------

  // Manter apenas containers com nome definido (descarta root slices e cgroups do host)
  rule {
    source_labels = ["name"]
    regex         = ".+"
    action        = "keep"
  }

  // Para métricas de CPU de container, manter apenas o agregado total (cpu="total")
  // evitando que múltiplos cores colidam em séries idênticas após o labeldrop de 'cpu'
  rule {
    source_labels = ["__name__", "cpu"]
    regex         = "container_cpu_usage_seconds_total;total|container_cpu_cfs_.*;.*|container_memory_.*;.*|container_network_.*;.*|container_oom_.*;.*"
    action        = "keep"
  }

  // Drop OCI / Docker / cAdvisor metadata
  rule {
    action = "labeldrop"
    regex  = "container_label_.+|id|image|cpu"
  }

  // Normalize labels (name -> container)
  rule {
    source_labels = ["name"]
    target_label  = "container"
  }

  rule {
    action = "labeldrop"
    regex  = "name"
  }

  // Common Labels
  rule {
    target_label = "service_name"
    replacement  = "cadvisor-exporter"
  }
}
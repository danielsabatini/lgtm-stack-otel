// Metrics
// Collector (exporter)
prometheus.exporter.self "alloy_local_exporter" { }

prometheus.scrape "alloy_local_scrape" {
  targets         = prometheus.exporter.self.alloy_local_exporter.targets
  forward_to      = [prometheus.relabel.alloy_local_transformer.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// Transformer (relabel): aplica identidade do container, sem passar pelo global_identity do host.
// instance="alloy-agent" identifica o processo Alloy, distinto das métricas do host (instance="lgtm-stack").
prometheus.relabel "alloy_local_transformer" {
  forward_to = [prometheus.remote_write.gateway.receiver]

  rule {
    target_label = "instance"
    replacement  = "alloy-agent"
  }

  rule {
    target_label = "service_name"
    replacement  = "alloy"
  }
}


// =============================================================================
// METRICS — Alloy Local (Self Monitoring)
// =============================================================================
// Pipeline: self_exporter -> scrape -> alloy_filter -> remote_write.gateway
// =============================================================================

prometheus.exporter.self "alloy_local_exporter" {}


prometheus.scrape "alloy_local_scrape" {
  targets         = prometheus.exporter.self.alloy_local_exporter.targets
  forward_to      = [prometheus.relabel.alloy_local_transformer.receiver]

  scrape_interval = "30s"
  scrape_timeout  = "10s"
}


prometheus.relabel "alloy_local_transformer" {
  forward_to = [
    prometheus.remote_write.gateway.receiver,
  ]

  // Keep only Alloy self-metrics (Descomente apenas para Debug/Troubleshooting)
  /*
  rule {
    source_labels = ["__name__"]
    regex         = "alloy_.+"
    action        = "keep"
  }
  */

  // Identity
  rule {
    target_label = "instance"
    replacement  = "alloy-agent"
  }

  rule {
    target_label = "service_name"
    replacement  = "alloy"
  }
}
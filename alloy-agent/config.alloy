// =============================================================================
// config.alloy — Alloy Agent (Coletor local de métricas e logs)
// =============================================================================
//
// Pipeline de dados deste agente:
//
//   [Host]  prometheus.exporter.unix ──► prometheus.scrape ──► prometheus.relabel ──┐
//   [Docker] prometheus.exporter.cadvisor ──► prometheus.scrape ──► prometheus.relabel ──┤
//                                                                                       ├──► prometheus.remote_write ──► alloy-gateway ──► Mimir
//   [Journal] loki.source.journal (N instâncias) ──► loki.relabel ──────────────────┤
//   [Docker]  discovery.docker ──► discovery.relabel ──► loki.source.docker ──► loki.process ──┤
//                                                                                              └──► loki.write ──► alloy-gateway ──► Loki
//
// Variáveis de ambiente injetadas via compose.yaml:
//   HOSTNAME, ENVIRONMENT, CLOUD_PROVIDER, CLOUD_REGION, CLOUD_AVAILABILITY_ZONE
//
// =============================================================================

// =============================================================================
// 1. MÉTRICAS DO HOST (Node Exporter)
//    Coleta métricas de CPU, memória, disco, rede e informações do SO.
//    Os paths /procfs, /sys e /rootfs são bind-mounts definidos no compose.yaml.
// =============================================================================
prometheus.exporter.unix "node_exporter" {
  procfs_path    = "/procfs"
  sysfs_path     = "/sys"
  rootfs_path    = "/rootfs"

  set_collectors = [
    "cpu", "meminfo", "diskstats", "filesystem",
    "netdev", "loadavg", "uname", "os", "stat",
  ]
}

prometheus.scrape "node_exporter_scrape" {
  targets         = prometheus.exporter.unix.node_exporter.targets
  forward_to      = [prometheus.relabel.node_metrics_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "node_metrics_labels" {
  forward_to = [prometheus.remote_write.metrics_gateway.receiver]

  // Allowlist: mantém apenas as métricas consumidas pelo dashboard Node Exporter (Self).
  // O Node Exporter expõe tudo que os collectors geram — sem filtro, o Mimir recebe
  // séries que nunca serão consultadas. O keep aqui é o ponto mais cedo possível.
  rule {
    source_labels = ["__name__"]
    regex         = "node_(boot_time_seconds|cpu_seconds_total|disk_(read_bytes_total|written_bytes_total|reads_completed_total|writes_completed_total)|filesystem_(avail_bytes|free_bytes|size_bytes|files|files_free)|load(1|5|15)|memory_(Buffers_bytes|Cached_bytes|MemAvailable_bytes|MemFree_bytes|MemTotal_bytes|SReclaimable_bytes|SwapTotal_bytes)|network_(receive|transmit)_(bytes_total|drop_total|errs_total)|uname_info)"
    action        = "keep"
  }

  // Droplist: descarta séries de dispositivos virtuais.
  // Aplicado após o allowlist — só alcança métricas node_disk_* e node_network_*
  // que já passaram pelo keep acima.
  rule {
    source_labels = ["__name__", "device"]
    regex         = "node_disk_.+;(loop|dm-|sr|fd|ram|zram|nbd).*"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__", "device"]
    regex         = "node_network_.+;lo"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__", "fstype"]
    regex         = "node_filesystem_.+;(tmpfs|devtmpfs|squashfs|overlay|aufs|iso9660)"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__", "mountpoint"]
    regex         = "node_filesystem_.+;(/docker/.*|/run/.*|/sys/.*|/proc/.*|/dev/.*)"
    action        = "drop"
  }

  rule {
    target_label = "job"
    replacement  = "node-exporter"
  }
  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// =============================================================================
// 2. MÉTRICAS DE CONTAINERS (cAdvisor)
//    Coleta métricas de CPU, memória e rede por container Docker.
//    Requer bind-mount do Docker socket e /var/lib/docker (compose.yaml).
// =============================================================================
prometheus.exporter.cadvisor "docker_exporter" {
  docker_host            = "unix:///var/run/docker.sock"
  storage_duration       = "5m"
  store_container_labels = false
}

prometheus.scrape "docker_exporter_scrape" {
  targets         = prometheus.exporter.cadvisor.docker_exporter.targets
  forward_to      = [prometheus.relabel.docker_exporter_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "docker_exporter_labels" {
  forward_to = [prometheus.remote_write.metrics_gateway.receiver]

  // Allowlist: mantém apenas métricas essenciais de container.
  // cAdvisor expõe ~200 métricas por container por default — sem filtro
  // explode cardinalidade com matrizes de container × device × operação.
  rule {
    source_labels = ["__name__"]
    // container_start_time_seconds removido: não possui painel no dashboard.
    // Para restaurar, adicione |start_time_seconds antes do parêntese de fechamento.
    regex         = "container_(cpu_usage_seconds_total|cpu_cfs_periods_total|cpu_cfs_throttled_periods_total|memory_usage_bytes|memory_working_set_bytes|network_receive_bytes_total|network_transmit_bytes_total|last_seen|oom_events_total)"
    action        = "keep"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "job"
    replacement  = "integrations/docker"
  }
  rule {
    target_label = "service_name"
    replacement  = "cadvisor"
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// =============================================================================
// 3. LOGS DO HOST VIA SYSTEMD JOURNAL
//    Lê logs do journald do host através dos bind-mounts:
//      /var/log/journal, /run/systemd/journal/socket e /etc/machine-id
//
//    IMPORTANTE: O atributo 'matches' do Alloy aceita múltiplos termos
//    separados por espaço com semântica de AND. OR com '+' não é suportado.
//    Para coletar múltiplos serviços do systemd com lógica de OR, crie uma
//    instância de loki.source.journal por serviço e encaminhe todas para o
//    mesmo pipeline de relabel.
//
//    Para adicionar um novo serviço (ex: nginx), basta copiar o bloco abaixo:
//      loki.source.journal "nginx" {
//        forward_to = [loki.relabel.systemd_journal_labels.receiver]
//        max_age    = "1h"
//        matches    = "_SYSTEMD_UNIT=nginx.service"
//      }
//
//    Para coletar TODOS os logs do host: crie uma única instância sem 'matches'.
// =============================================================================

loki.source.journal "docker_daemon" {
  forward_to = [loki.relabel.systemd_journal_labels.receiver]
  max_age    = "1h"
  matches    = "_SYSTEMD_UNIT=docker.service"
}

loki.source.journal "sshd" {
  forward_to = [loki.relabel.systemd_journal_labels.receiver]
  max_age    = "1h"
  matches    = "_SYSTEMD_UNIT=sshd.service"
}

// Pipeline de relabel compartilhado por todas as instâncias de journal acima.
// Extrai o nome do serviço (docker, sshd, etc.) da label _SYSTEMD_UNIT
// e adiciona labels de contexto (instance, environment, cloud_*).
loki.relabel "systemd_journal_labels" {
  forward_to = [loki.write.logs_gateway.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    source_labels = ["_SYSTEMD_UNIT"]
    regex         = "(.*)\\.service"
    target_label  = "service_name"
  }
  rule {
    target_label = "job"
    replacement  = "system/journal"
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// =============================================================================
// 4. LOGS DE CONTAINERS (stdout/stderr via Docker socket)
//    Coleta logs de todos os containers via Docker API.
//    Fecha o gap de correlação: métricas de container (cAdvisor) ↔ logs de aplicação.
//    O label "service_name" é extraído do nome do container para que os logs
//    e métricas possam ser correlacionados no mesmo dashboard do Grafana.
//
//    Pipeline: discovery.docker → discovery.relabel → loki.source.docker → loki.process → loki.write
// =============================================================================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// IMPORTANTE: A extração de meta-labels (__meta_docker_*) DEVE ser feita na
// fase de 'discovery.relabel', ANTES da coleta. Se for feita no 'loki.relabel'
// (pós-coleta), as meta-labels já terão sido descartadas pelo agente.
discovery.relabel "container_logs_targets" {
  targets = discovery.docker.containers.targets

  // Extrai o nome do container (ex: /mimir -> mimir)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/*(.*)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  // Mapeamos também para a label "name" para espelhar perfeitamente o cAdvisor
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/*(.*)$"
    target_label  = "name"
    replacement   = "$1"
  }

  rule {
    target_label = "job"
    replacement  = "docker/containers"
  }
  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// Coleta os logs de stdout/stderr dos containers descobertos acima.
// Os logs passam por loki.process para extração de nível (level) antes do envio.
loki.source.docker "container_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.container_logs_targets.output
  forward_to = [loki.process.container_logs_filter.receiver]
}

// Enriquece os logs de container com o nível (level) extraído do conteúdo.
// Usa Structured Metadata nativo do Loki v3 para indexar o level sem
// explodir a cardinalidade de labels convencionais.
loki.process "container_logs_filter" {
  forward_to = [loki.write.logs_gateway.receiver]

  // Extrai o Level do Log via regex hibrida (funciona para logfmt e JSON bruto)
  stage.regex {
    expression = "(?i)(level|lvl|severity)[\\s]*[=:]?[\\s]*[\"']?(?P<level>debug|info|warn|warning|error|fatal|trace)[\"']?"
  }

  // Grava dinamicamente como "Structured Metadata" nativo do Loki v3 (Nao explode labels indexadas)
  stage.structured_metadata {
    values = {
      level = "level",
    }
  }

  // ATENCAO: Drop de logs DEBUG mantido comentado intencionalmente.
  // Em ambientes de producao pesados, descomente o bloco 'stage.drop' abaixo 
  // para economizar trafego e armazenamento descartando ruido de depuracao:
  //
  // stage.drop {
  //   source = "level"
  //   expression = "(?i)^(debug|trace)$"
  // }
}

// =============================================================================
// 5. EXPORTAÇÃO (Destinos Finais)
//    Todos os pipelines de métricas e logs convergem para o alloy-gateway,
//    que atua como proxy/fanout para os backends Mimir (métricas) e Loki (logs).
// =============================================================================
prometheus.remote_write "metrics_gateway" {
  endpoint {
    url = "http://alloy-gateway:9999/api/v1/metrics/write"
  }
}

loki.write "logs_gateway" {
  endpoint {
    url = "http://alloy-gateway:9998/loki/api/v1/push"
  }
}

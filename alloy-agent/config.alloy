// =============================================================================
// ALLOY AGENT - COLETOR DO HOST E REDE INTERNA
// =============================================================================

// =============================================================================
// MÉTRICAS DO HOST
// =============================================================================
prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host"
  set_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "loadavg", "uname"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.fix_job.receiver]
  scrape_interval = "60s"
  scrape_timeout  = "30s"

  clustering {
    enabled = false
  }
}

// Garante compatibilidade total com o dashboard Node Exporter Full (ID 1860):
// - job="node-exporter" → variável Job do dashboard
// - nodename → variável Nodename do dashboard (requer este label explicitamente)
// - instance → mantém o hostname do container como identificador
prometheus.relabel "fix_job" {
  forward_to = [prometheus.remote_write.gateway.receiver]

  // Sobrescreve job para bater com o filtro padrão do Node Exporter Full
  rule {
    target_label = "job"
    replacement  = "node-exporter"
  }

  // Injeta nodename usando o hostname do sistema lido em runtime
  rule {
    target_label = "nodename"
    replacement  = env("HOSTNAME")
  }

  // Garante que instance também seja legível (hostname) para correlação
  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }
}

// Auto-Monitoramento do próprio Agent
prometheus.exporter.self "alloy_agent" {}
prometheus.scrape "alloy_agent" {
  targets         = prometheus.exporter.self.alloy_agent.targets
  forward_to      = [prometheus.remote_write.gateway.receiver]
  job_name        = "alloy-agent"
  scrape_interval = "60s"
  scrape_timeout  = "30s"
}

// Envio de métricas para o Gateway
prometheus.remote_write "gateway" {
  endpoint {
    url = "http://alloy-gateway:9999/api/v1/metrics/write"
  }
}

// =============================================================================
// COLETA DE LOGS DO JOURNAL
// =============================================================================
loki.source.journal "system" {
  forward_to = [loki.relabel.journal.receiver]
  max_age    = "12h"
  matches    = "_SYSTEMD_UNIT=docker.service"
}

loki.relabel "journal" {
  forward_to = [loki.process.labels.receiver]
  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }
}

loki.process "labels" {
  forward_to = [loki.write.gateway.receiver]
  stage.label_drop {
    values = ["_SOURCE_REALTIME_TIMESTAMP"]
  }
}

// Envio de logs para o Gateway
loki.write "gateway" {
  endpoint {
    url = "http://alloy-gateway:9998/loki/api/v1/push"
  }
}

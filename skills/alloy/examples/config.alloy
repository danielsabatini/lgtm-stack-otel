// 1. Métricas
// 1.1. Alloy
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.relabel.default_metrics_relabel.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// 1.2. Métricas Node
prometheus.exporter.unix "node" {
  procfs_path    = "/procfs"
  sysfs_path     = "/sys"
  rootfs_path    = "/rootfs"
  set_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "netdev", "loadavg", "uname", "os", "stat"]
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.node_filter.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "node_filter" {
  forward_to = [prometheus.relabel.default_metrics_relabel.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "node_(boot_time_seconds|cpu_seconds_total|disk_(read_bytes_total|reads_completed_total|written_bytes_total)|filesystem_(avail_bytes|files|files_free|free_bytes|size_bytes)|load(1|5|15)|memory_(Buffers_bytes|Cached_bytes|MemAvailable_bytes|MemFree_bytes|MemTotal_bytes|SReclaimable_bytes|SwapTotal_bytes)|network_(receive_bytes_total|receive_drop_total|receive_errs_total|transmit_bytes_total|transmit_drop_total|transmit_errs_total)|uname_info)"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}

// 1.3. Métricas Docker
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "docker" {
  targets    = prometheus.exporter.cadvisor.docker.targets
  forward_to = [prometheus.relabel.docker_filter.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "docker_filter" {
  forward_to = [prometheus.relabel.default_metrics_relabel.receiver]

  rule {
    source_labels = ["__name__"]
    // container_start_time_seconds removido: nao possui painel no dashboard.
    // Para restaurar, adicione |start_time_seconds antes do parentese de fechamento.
    regex         = "container_(cpu_usage_seconds_total|cpu_cfs_periods_total|cpu_cfs_throttled_periods_total|memory_usage_bytes|memory_working_set_bytes|network_receive_bytes_total|network_transmit_bytes_total|last_seen|oom_events_total)"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "cadvisor"
  }
}

// 1.4. Métricas Relabel Padrão
prometheus.relabel "default_metrics_relabel" {
  forward_to = [prometheus.remote_write.metrics.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// 2. Logs
// 2.1. Logs de Segurança (SEC)
loki.source.journal "sec" {
  forward_to = [loki.process.sec.receiver]
  matches    = "_SYSTEMD_UNIT=ssh.service"
}

loki.process "sec" {
  forward_to = [loki.process.default_logs_process.receiver]

  stage.regex {
    source     = "_SYSTEMD_UNIT"
    expression = "(?P<service_name>.*)\\.service"
  }
  stage.labels { values = { service_name = "service_name" } }

  stage.static_labels { values = { category = "sec" } }
}

// 2.2. Logs do Sistema (SYS)
loki.source.journal "sys" {
  forward_to = [loki.process.sys.receiver]
  matches    = "_TRANSPORT=kernel"
}

loki.process "sys" {
  forward_to = [loki.process.default_logs_process.receiver]

  stage.regex {
    source     = "SYSLOG_IDENTIFIER"
    expression = "(?P<service_name>.+)"
  }
  stage.labels { values = { service_name = "service_name" } }

  stage.drop {
    source = "PRIORITY"
    value  = "5"
  }
  stage.drop {
    source = "PRIORITY"
    value  = "6"
  }
  stage.drop {
    source = "PRIORITY"
    value  = "7"
  }

  stage.static_labels { values = { category = "sys" } }
}

// 2.3. Logs de Serviços (SVC)
loki.source.journal "svc_docker" {
  forward_to = [loki.process.svc.receiver]
  matches    = "_SYSTEMD_UNIT=docker.service"
}

loki.source.journal "svc_containerd" {
  forward_to = [loki.process.svc.receiver]
  matches    = "_SYSTEMD_UNIT=containerd.service"
}

loki.source.journal "svc_cron" {
  forward_to = [loki.process.svc.receiver]
  matches    = "_SYSTEMD_UNIT=cron.service"
}

loki.source.journal "svc_timesyncd" {
  forward_to = [loki.process.svc.receiver]
  matches    = "_SYSTEMD_UNIT=systemd-timesyncd.service"
}

loki.process "svc" {
  forward_to = [loki.process.default_logs_process.receiver]

  stage.regex {
    source     = "_SYSTEMD_UNIT"
    expression = "(?P<service_name>.*)\\.service"
  }
  stage.labels { values = { service_name = "service_name" } }

  stage.drop {
    source = "PRIORITY"
    value  = "5"
  }
  stage.drop {
    source = "PRIORITY"
    value  = "6"
  }
  stage.drop {
    source = "PRIORITY"
    value  = "7"
  }

  stage.static_labels { values = { category = "svc" } }
}

// 2.4. Logs de Infraestrutura (INF)
loki.source.journal "inf" {
  forward_to = [loki.process.inf.receiver]
  matches    = "SYSLOG_IDENTIFIER=systemd"
}

loki.process "inf" {
  forward_to = [loki.process.default_logs_process.receiver]

  stage.regex {
    source     = "SYSLOG_IDENTIFIER"
    expression = "(?P<service_name>.+)"
  }
  stage.labels { values = { service_name = "service_name" } }

  stage.static_labels { values = { category = "inf" } }
}

// 2.5. Logs Processamento Padrão
loki.process "default_logs_process" {
  forward_to = [loki.relabel.default_logs_relabel.receiver]

  stage.template {
    source   = "PRIORITY"
    template = `
      {{- if eq .Value "0" -}}emergency
      {{- else if eq .Value "1" -}}alert
      {{- else if eq .Value "2" -}}critical
      {{- else if eq .Value "3" -}}error
      {{- else if eq .Value "4" -}}warning
      {{- else if eq .Value "5" -}}notice
      {{- else if eq .Value "6" -}}info
      {{- else if eq .Value "7" -}}debug
      {{- else -}}unknown
      {{- end -}}`
  }
  stage.labels { values = { level = "PRIORITY" } }
}

// 2.6. Logs Relabel Padrão
loki.relabel "default_logs_relabel" {
  forward_to = [loki.write.logs.receiver]

  rule {
    target_label  = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// 3. Exportação
// 3.1. Exportação Métricas
prometheus.remote_write "metrics" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

// 3.2. Exportação Logs
loki.write "logs" {
  endpoint { url = "http://alloy-gateway:9998/loki/api/v1/push" }
}
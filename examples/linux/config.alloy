// -------------------- LOGS: systemd --------------------

loki.relabel "systemd_journal_labels" {
 forward_to=[]
 rule {
   source_labels=["__journal_priority"]
   target_label="priority"
 }
}

loki.source.journal "systemd" {
 forward_to=[loki.relabel.systemd_labels.receiver]
 matches="SYSLOG_IDENTIFIER=systemd"
 relabel_rules=loki.relabel.systemd_journal_labels.rules
}

loki.relabel "systemd_labels" {
 forward_to=[loki.process.systemd_normalize.receiver]

 rule { source_labels=["priority"] regex="[012]" target_label="level" replacement="critical" }
 rule { source_labels=["priority"] regex="3" target_label="level" replacement="error" }
 rule { source_labels=["priority"] regex="[45]" target_label="level" replacement="warn" }
 rule { source_labels=["priority"] regex="6" target_label="level" replacement="info" }
 rule { source_labels=["priority"] regex="7" target_label="level" replacement="debug" }

 rule {
   source_labels=["level"]
   regex="^$"
   target_label="level"
   replacement="unknown"
 }
}

loki.process "systemd_normalize" {
 forward_to=[loki.relabel.global_identity.receiver]

 stage.match {
   selector=`{level=~"info|debug"}`
   action="drop"
 }

 stage.label_drop {
   values=["priority","job"]
 }

 stage.static_labels {
   values = {
     category="platform",
     service_name="systemd",
   }
 }
}


// -------------------- GLOBAL LABELS --------------------

prometheus.relabel "host_info_extractor" {
 forward_to=[prometheus.relabel.global_identity.receiver]

 rule {
   source_labels=["__name__","sysname"]
   regex="node_uname_info;(.*)"
   target_label="os"
   replacement="$1"
 }

 rule {
   source_labels=["os"]
   target_label="os"
   action="lowercase"
 }

 rule {
   source_labels=["__name__","machine"]
   regex="node_uname_info;(.*)"
   target_label="architecture"
   replacement="$1"
 }

 rule {
   source_labels=["__name__","release"]
   regex="node_uname_info;(.*)"
   target_label="kernel_release"
   replacement="$1"
 }

 rule {
   source_labels=["__name__","name"]
   regex="node_os_info;(.*)"
   target_label="os_product"
   replacement="$1"
 }

 rule {
   source_labels=["__name__","version_id"]
   regex="node_os_info;(.*)"
   target_label="os_version"
   replacement="$1"
 }
}

prometheus.relabel "global_identity" {
 forward_to=[prometheus.remote_write.gateway.receiver]

 rule { target_label="instance" replacement=sys.env("HOSTNAME") }
 rule { target_label="environment" replacement="prd" }
 rule { target_label="cloud_provider" replacement="mgc" }
 rule { target_label="cloud_region" replacement="br-se1" }
 rule { target_label="cloud_availability_zone" replacement="a" }
}

loki.relabel "global_identity" {
 forward_to=[loki.write.gateway.receiver]

 rule { target_label="instance" replacement=sys.env("HOSTNAME") }
 rule { target_label="environment" replacement="prd" }
 rule { target_label="cloud_provider" replacement="mgc" }
 rule { target_label="cloud_region" replacement="br-se1" }
 rule { target_label="cloud_availability_zone" replacement="a" }
}


// -------------------- OUTPUTS --------------------

prometheus.remote_write "gateway" {
 endpoint {
   url="http://lgtm-stack:9999/api/v1/metrics/write"
 }
}

loki.write "gateway" {
 endpoint {
   url="http://lgtm-stack:9998/loki/api/v1/push"
 }
}

// =============================================================================
// EXEMPLO ALLOY AGENT: LINUX HOST (LEAN)
// Foco: Apenas os Golden Signals do Kernel e falhas extremas em syslogs.
// Aviso de Traces: Traces devem ser enviados via SDK das aplicações para o Gateway.
// =============================================================================

// =============================================================================
// 1. MÉTRICAS (Mínimas Necessárias)
// =============================================================================
prometheus.exporter.unix "linux_host" {
  // Ignora centenas de telemetrias inúteis ativando estritamente saúde do Host
  set_collectors = [
    "cpu",
    "meminfo",
    "diskstats",
    "filesystem",
    "netdev",
    "loadavg",
  ]
}

prometheus.scrape "linux_metrics" {
  targets        = prometheus.exporter.unix.linux_host.targets
  job_name       = "linux-node"
  scrape_interval = "60s"
  
  // Envia direto para a porta interna do Alloy Gateway Central
  forward_to     = [prometheus.remote_write.gateway.receiver]
}

prometheus.remote_write "gateway" {
  endpoint {
    url = "http://alloy-gateway:9999/api/v1/metrics/write"
  }
}

// =============================================================================
// 2. LOGS DO SO (Filtro Anti-Ruído)
// =============================================================================
loki.source.journal "system" {
  // Garante que só puxaremos logs que derivem de componentes essenciais
  // Descartaremos por exemplo cronjobs, ssh, pam sessions, etc.
  matches    = "_SYSTEMD_UNIT=docker.service"
  max_age    = "12h"
  forward_to = [loki.relabel.journal.receiver]
}

loki.relabel "journal" {
  forward_to = [loki.process.labels.receiver]
  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }
}

loki.process "labels" {
  forward_to = [loki.write.gateway.receiver]
  stage.label_drop {
    values = ["_SOURCE_REALTIME_TIMESTAMP"]
  }
}

loki.write "gateway" {
  endpoint {
    url = "http://alloy-gateway:9998/loki/api/v1/push"
  }
}

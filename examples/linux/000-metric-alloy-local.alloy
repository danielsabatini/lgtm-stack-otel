// Metrics
// Collector (exporter): expõe métricas internas do processo Alloy.
prometheus.exporter.self "alloy_local_exporter" { }

// Collector (scrape)
prometheus.scrape "alloy_local_scrape" {
  targets         = prometheus.exporter.self.alloy_local_exporter.targets
  forward_to      = [prometheus.relabel.alloy_local_transformer.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// Transformer (relabel)
prometheus.relabel "alloy_local_transformer" {
  forward_to = [prometheus.remote_write.alloy_local_gateway.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }

  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }

  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// Writer (endpoint)
// Adicione "lgtm-stack" ao DNS ou em /etc/hosts apontando para o IP
// do servidor que executa a stack LGTM (alloy-gateway porta 9999).
prometheus.remote_write "alloy_local_gateway" {
  endpoint { url = "http://lgtm-stack:9999/api/v1/metrics/write" }
}

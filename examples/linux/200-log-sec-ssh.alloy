// Logs
// Collector (journal): coleta logs do serviço SSH via systemd journal.
// Sem filtro de drop — todos os eventos de autenticação são preservados
// para auditoria de segurança (logins, falhas, sessões abertas/fechadas).
loki.source.journal "ssh" {
  forward_to     = [loki.relabel.ssh_transform.receiver]
  matches        = "_SYSTEMD_UNIT=ssh.service"
  relabel_rules  = loki.relabel.ssh_journal_labels.rules
}

loki.relabel "ssh_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }
}

// Transformer (relabel)
loki.relabel "ssh_transform" {
  forward_to = [loki.process.ssh_normalize.receiver]

  rule {
    source_labels = ["priority"]
    regex         = "[012]"
    target_label  = "level"
    replacement   = "critical"
  }

  rule {
    source_labels = ["priority"]
    regex         = "3"
    target_label  = "level"
    replacement   = "error"
  }

  rule {
    source_labels = ["priority"]
    regex         = "[45]"
    target_label  = "level"
    replacement   = "warn"
  }

  rule {
    source_labels = ["priority"]
    regex         = "6"
    target_label  = "level"
    replacement   = "info"
  }

  rule {
    source_labels = ["priority"]
    regex         = "7"
    target_label  = "level"
    replacement   = "debug"
  }

  rule {
    source_labels = ["level"]
    regex         = "^$"
    target_label  = "level"
    replacement   = "unknown"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }

  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }

  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// Transformer (process)
loki.process "ssh_normalize" {
  forward_to = [loki.write.ssh_gateway.receiver]

  stage.label_drop {
    values = ["priority", "job"]
  }

  stage.static_labels {
    values = {
      category     = "security",
      service_name = "ssh",
    }
  }
}

// Writer (endpoint)
// Adicione "lgtm-stack" ao DNS ou em /etc/hosts apontando para o IP
// do servidor que executa a stack LGTM (alloy-gateway porta 9998).
loki.write "ssh_gateway" {
  endpoint { url = "http://lgtm-stack:9998/loki/api/v1/push" }
}

// 1. Métricas
// 1.1. Alloy
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.relabel.default_metrics_relabel.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// 1.2. Métricas Node
prometheus.exporter.unix "node" {
  procfs_path    = "/procfs"
  sysfs_path     = "/sys"
  rootfs_path    = "/rootfs"
  set_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "netdev", "loadavg", "uname", "os", "stat"]
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.node_filter.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "node_filter" {
  forward_to = [prometheus.relabel.default_metrics_relabel.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "node_(boot_time_seconds|cpu_seconds_total|disk_(read_bytes_total|reads_completed_total|written_bytes_total)|filesystem_(avail_bytes|files|files_free|free_bytes|size_bytes)|load(1|5|15)|memory_(Buffers_bytes|Cached_bytes|MemAvailable_bytes|MemFree_bytes|MemTotal_bytes|SReclaimable_bytes|SwapTotal_bytes)|network_(receive_bytes_total|receive_drop_total|receive_errs_total|transmit_bytes_total|transmit_drop_total|transmit_errs_total)|uname_info)"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}

// 1.3. Métricas Docker
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "docker" {
  targets    = prometheus.exporter.cadvisor.docker.targets
  forward_to = [prometheus.relabel.docker_filter.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "docker_filter" {
  forward_to = [prometheus.relabel.default_metrics_relabel.receiver]

  rule {
    source_labels = ["__name__"]
    // container_start_time_seconds removido: nao possui painel no dashboard.
    // Para restaurar, adicione |start_time_seconds antes do parentese de fechamento.
    regex         = "container_(cpu_usage_seconds_total|cpu_cfs_periods_total|cpu_cfs_throttled_periods_total|memory_usage_bytes|memory_working_set_bytes|network_receive_bytes_total|network_transmit_bytes_total|last_seen|oom_events_total)"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "cadvisor"
  }
}

// 1.4. Métricas Relabel Padrão
prometheus.relabel "default_metrics_relabel" {
  forward_to = [prometheus.remote_write.metrics.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}


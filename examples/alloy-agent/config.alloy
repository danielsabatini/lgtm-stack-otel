// 2.2. Logs do Sistema (SYS)
loki.source.journal "sys" {
  forward_to     = [loki.relabel.sys_extract.receiver]
  matches        = "_TRANSPORT=kernel"
  relabel_rules  = loki.relabel.sys_journal_labels.rules
}

loki.relabel "sys_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }
}

loki.relabel "sys_extract" {
  forward_to = [loki.process.sys.receiver]

  rule {
    source_labels = ["priority"]
    target_label  = "priority"
  }

  rule {
    source_labels = ["priority"]
    regex         = "0"
    target_label  = "level"
    replacement   = "emergency"
  }
  rule {
    source_labels = ["priority"]
    regex         = "1"
    target_label  = "level"
    replacement   = "alert"
  }
  rule {
    source_labels = ["priority"]
    regex         = "2"
    target_label  = "level"
    replacement   = "critical"
  }
  rule {
    source_labels = ["priority"]
    regex         = "3"
    target_label  = "level"
    replacement   = "error"
  }
  rule {
    source_labels = ["priority"]
    regex         = "4"
    target_label  = "level"
    replacement   = "warning"
  }
  rule {
    source_labels = ["priority"]
    regex         = "5"
    target_label  = "level"
    replacement   = "notice"
  }
  rule {
    source_labels = ["priority"]
    regex         = "6"
    target_label  = "level"
    replacement   = "info"
  }
  rule {
    source_labels = ["priority"]
    regex         = "7"
    target_label  = "level"
    replacement   = "debug"
  }
}

loki.process "sys" {
  forward_to = [loki.relabel.logs_mapping_default.receiver]

  stage.match {
    selector = `{priority=~"5|6|7"}`
    action   = "drop"
  }

  stage.label_drop {
    values = ["priority"]
  }

  stage.static_labels {
    values = {
      category     = "sys",
      service_name = "kernel",
    }
  }
}

// 2.3. Logs de Serviços (SVC)
loki.source.journal "svc" {
  forward_to = [
    loki.relabel.svc_docker_filter.receiver
  ]
  relabel_rules = loki.relabel.svc_journal_labels.rules
}

loki.relabel "svc_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label = "identifier"
  }
}

loki.relabel "svc_docker_filter" {
  forward_to = [loki.process.svc_docker_process.receiver]
  
  rule { 
    source_labels = ["unit"]
    regex = "docker.service"
    action = "keep"
    }
  
loki.process "svc_docker_process" {
  forward_to = [loki.relabel.logs_level_default.receiver]
  
  stage.match {
    selector = `{priority=~"5|6|7"}`
    action = "drop"
  }
  
  stage.static_labels {
    values = {
      category = "svc"
      service_name = "docker"
      }
  }
}  


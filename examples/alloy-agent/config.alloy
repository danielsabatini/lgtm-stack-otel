loki.relabel "logs_level_default" {
  forward_to = [loki.relabel.logs_mapping_default.receiver]
  
  rule {
    source_labels = ["priority"]
    target_label  = "priority"
  }

  rule {
    source_labels = ["priority"]
    regex         = "0"
    target_label  = "level"
    replacement   = "emergency"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "1"
    target_label  = "level"
    replacement   = "alert"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "2"
    target_label  = "level"
    replacement   = "critical"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "3"
    target_label  = "level"
    replacement   = "error"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "4"
    target_label  = "level"
    replacement   = "warning"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "5"
    target_label  = "level"
    replacement   = "notice"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "6"
    target_label  = "level"
    replacement   = "info"
  }
  
  rule {
    source_labels = ["priority"]
    regex         = "7"
    target_label  = "level"
    replacement   = "debug"
  }
}

// 2.5. Logs Mapping Padrão
loki.relabel "logs_mapping_default" {
  forward_to = [loki.write.logs.receiver]

  rule {
    target_label  = "instance"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "cloud_provider"
    replacement  = sys.env("CLOUD_PROVIDER")
  }
  rule {
    target_label = "cloud_region"
    replacement  = sys.env("CLOUD_REGION")
  }
  rule {
    target_label = "cloud_availability_zone"
    replacement  = sys.env("CLOUD_AVAILABILITY_ZONE")
  }
}

// 3. Exportação
// 3.1. Exportação Métricas
prometheus.remote_write "metrics" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

// 3.2. Exportação Logs
loki.write "logs" {
  endpoint { url = "http://alloy-gateway:9998/loki/api/v1/push" }
}

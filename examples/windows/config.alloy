// =============================================================================
// Grafana Alloy — Configuração para servidor Windows
// =============================================================================
// Coleta métricas e logs do host e envia para o alloy-gateway da stack LGTM.
//
// Estrutura:
// 10 Metrics — Alloy Self
// 11 Metrics — Windows Host
// 20 Logs — Security
// 21 Logs — System
// 22 Logs — Application
// 23 Logs — Platform
// 90 Global Identity
// 99 Outputs
// =============================================================================


// =============================================================================
// 10 METRICS — Alloy Self
// =============================================================================

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.relabel.alloy_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "alloy_labels" {
  forward_to = [prometheus.relabel.host_info_extractor.receiver]

  rule {
    target_label = "service_name"
    replacement  = "alloy"
  }

  // Keep only Alloy self-metrics (Descomente apenas para Debug/Troubleshooting)
  /*
  rule {
    source_labels = ["__name__"]
    regex         = "alloy_.+"
    action        = "keep"
  }
  */
}


// =============================================================================
// 11 METRICS — Windows Host
// =============================================================================

prometheus.exporter.windows "host" {
  enabled_collectors = [
    "cpu",
    "logical_disk",
    "net",
    "os",
    "system",
    "memory",
    "pagefile",
  ]
}

prometheus.scrape "windows_host" {
  targets         = prometheus.exporter.windows.host.targets
  forward_to      = [prometheus.relabel.windows_host_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "windows_host_labels" {
  forward_to = [prometheus.relabel.host_info_extractor.receiver]

  // -------------------------------------------------------------------------
  // Metric allowlist grouped by collector family
  // -------------------------------------------------------------------------
  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // Core & System
      "windows_system_boot_time_timestamp|" +
      "windows_os_info|" +

      // CPU & System
      "windows_cpu_time_total|" +
      "windows_system_boot_time_timestamp|" +
      "windows_system_processor_queue_length|" +

      // Memory
      "windows_memory_physical_total_bytes|" +
      "windows_memory_available_bytes|" +
      "windows_memory_cache_bytes|" +

      // Pagefile
      "windows_pagefile_limit_bytes|" +
      "windows_pagefile_free_bytes|" +

      // Disk & Filesystem
      "windows_logical_disk_size_bytes|" +
      "windows_logical_disk_free_bytes|" +
      "windows_logical_disk_read_bytes_total|" +
      "windows_logical_disk_reads_total|" +
      "windows_logical_disk_write_bytes_total|" +
      "windows_logical_disk_writes_total|" +

      // Network
      "windows_net_bytes_total|" +
      "windows_net_bytes_received_total|" +
      "windows_net_bytes_sent_total|" +
      "windows_net_current_bandwidth_bytes|" +
      "windows_net_packets_outbound_discarded_total|" +
      "windows_net_packets_outbound_errors_total|" +
      "windows_net_packets_received_discarded_total|" +
      "windows_net_packets_received_errors_total"
  }


  // Keep valid drive volumes only
  rule {
    source_labels = ["volume"]
    regex         = "^([A-Z]:|)$"
}
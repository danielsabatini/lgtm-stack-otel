// =============================================================================
// Grafana Alloy — Configuração para servidor Windows
// =============================================================================
// Coleta métricas e logs do host e envia para o alloy-gateway da stack LGTM.
//
// Estrutura:
// 10 Metrics — Alloy Self
// 11 Metrics — Windows Host
// 20 Logs — Security
// 21 Logs — System
// 22 Logs — Application
// 23 Logs — Platform
// 90 Global Identity
// 99 Outputs
// =============================================================================


// =============================================================================
// 10 METRICS — Alloy Self
// =============================================================================

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.relabel.alloy_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "alloy_labels" {
  forward_to = [prometheus.relabel.host_info_extractor.receiver]

  rule {
    target_label = "service_name"
    replacement  = "alloy"
  }
}


// =============================================================================
// 11 METRICS — Windows Host
// =============================================================================

prometheus.exporter.windows "host" {
  enabled_collectors = [
    "cpu",
    "logical_disk",
    "net",
    "os",
    "system",
    "memory",
    "pagefile",
  ]
}

prometheus.scrape "windows_host" {
  targets         = prometheus.exporter.windows.host.targets
  forward_to      = [prometheus.relabel.windows_host_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "windows_host_labels" {
  forward_to = [prometheus.relabel.host_info_extractor.receiver]

  // -------------------------------------------------------------------------
  // Metric allowlist grouped by collector family
  // -------------------------------------------------------------------------
  rule {
    source_labels = ["__name__"]

    regex = "windows_(cpu_time_total|logical_disk_(free_bytes|read_bytes_total|reads_total|size_bytes|write_bytes_total|writes_total)|memory_(available_bytes|cache_bytes|physical_total_bytes)|net_(bytes_received_total|bytes_sent_total|packets_outbound_discarded_total|packets_outbound_errors_total|packets_received_discarded_total|packets_received_errors_total)|os_info|pagefile_limit_bytes|system_(boot_time_timestamp|processor_queue_length))"

    action = "keep"
  }


  // Keep valid drive volumes only
  rule {
    source_labels = ["volume"]
    regex         = "^([A-Z]:|)$"
}
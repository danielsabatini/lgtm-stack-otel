// =============================================================================
// EXEMPLO ALLOY AGENT: SQL SERVER (LEAN)
// Foco: Usando o MSSQL nativo e o EventLog XPath restrito para o Engine MS.
// Aviso de Traces: Bancos de Dados não operam Traces diretamente via agent.
// =============================================================================

// =============================================================================
// 1. MÉTRICAS (Mínimas Necessárias)
// =============================================================================
prometheus.exporter.mssql "db_sqlserver" {
  connection_string = "sqlserver://alloy_exporter:senha_segura@localhost:1433"
  
  // O MSSQL Exporter do Alloy entrega as métricas de saúde primária do banco nativamente.
  // Pode usar 'custom_queries' em YAML se quiser rastreadores extras (não recomendado para OOTB minimal)
}

prometheus.scrape "mssql_metrics" {
  targets         = prometheus.exporter.mssql.db_sqlserver.targets
  job_name        = "sqlserver-cluster"
  scrape_interval = "60s"
  
  forward_to      = [prometheus.remote_write.gateway.receiver]
}

prometheus.remote_write "gateway" {
  endpoint {
    url = "http://alloy-gateway.meudominio.internal:9999/api/v1/metrics/write"
  }
}

// =============================================================================
// 2. LOGS DO SO (Filtro XPath de Alta Performance no Event Viewer)
// =============================================================================
loki.source.windowsevent "mssql_errors" {
  eventlog_name = "Application"
  // MAGIA AQUI: O MSSQL cospe tudo (Selects e Success) no EventViewer, arruinando a CPU.
  // Filtramos diretamente no Kernel via XPath:
  // - Requer Provider Name = MSSQLSERVER
  // - Requer Level = 1 (Critical) ou Level = 2 (Error)
  xpath_query   = "*[System[Provider[@Name='MSSQLSERVER'] and (Level=1 or Level=2)]]"
  
  forward_to    = [loki.relabel.mssql_format.receiver]
}

loki.relabel "mssql_format" {
  forward_to = [loki.write.gateway_logs.receiver]
  rule {
    target_label = "service_name"
    replacement  = "sqlserver"
  }
}

loki.write "gateway_logs" {
  endpoint {
    url = "http://alloy-gateway.meudominio.internal:9998/loki/api/v1/push"
  }
}

// =============================================================================
// EXEMPLO ALLOY GATEWAY - PULL DE WINDOWS + MSSQL EXPORTER LEGADO
//
// Como Usar:
// Copie este arquivo para 'lgtm-stack/alloy-gateway/conf.d/' e reinicie o Gateway.
// Esta configuração faz o scraping de servidores Windows que expõem métricas do
// host Windows E do Microsoft SQL Server via windows_exporter com o coletor
// 'mssql' habilitado (porta padrão 9182).
//
// Pré-requisito: habilitar o coletor mssql no windows_exporter:
//   --collectors.enabled=cpu,logical_disk,memory,net,os,system,mssql,pagefile
//
// Para coleta completa (Windows + MSSQL via Alloy agent), use examples/push/windows-mssql/config.alloy.
//
// IMPORTANTE: Substitua as variáveis [IP_ADDRESS] pelo IP/porta real do host e [INSTANCE_NAME] por um nome único para a instância.
// Os valores de environment, cloud_provider, cloud_region e cloud_availability_zone são padrões para produção no Magalu Cloud (br-se1 zona a) e devem ser alterados conforme a necessidade.
// =============================================================================

prometheus.scrape "pull_windows_mssql_host" {
  // Lista EXPLÍCITA de servidores Windows legados com windows_exporter na porta 9182
  targets = [
    {
      "__address__"             = "[IP_ADDRESS]:9182",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "[IP_ADDRESS]:9182",
    //   "instance"                = "[INSTANCE_NAME]",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "windows-mssql-legacy"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [
    prometheus.relabel.pull_windows_mssql_host_transformer.receiver,
    prometheus.relabel.pull_windows_mssql_host_db_transformer.receiver,
  ]
}


// =============================================================================
// WINDOWS HOST
// =============================================================================

// Transformer (relabel): mantém apenas as mesmas métricas coletadas pelo Alloy agent
// e adiciona labels de identidade do host.
prometheus.relabel "pull_windows_mssql_host_transformer" {
  forward_to = [prometheus.relabel.pull_windows_mssql_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // Core & System
      "windows_system_boot_time_timestamp|" +
      "windows_os_info|" +

      // CPU & System
      "windows_cpu_time_total|" +
      "windows_system_processor_queue_length|" +

      // Memory
      "windows_memory_physical_total_bytes|" +
      "windows_memory_available_bytes|" +
      "windows_memory_cache_bytes|" +

      // Pagefile
      "windows_pagefile_limit_bytes|" +
      "windows_pagefile_free_bytes|" +

      // Disk & Filesystem
      "windows_logical_disk_size_bytes|" +
      "windows_logical_disk_free_bytes|" +
      "windows_logical_disk_read_bytes_total|" +
      "windows_logical_disk_reads_total|" +
      "windows_logical_disk_write_bytes_total|" +
      "windows_logical_disk_writes_total|" +

      // Network
      "windows_net_bytes_total|" +
      "windows_net_bytes_received_total|" +
      "windows_net_bytes_sent_total|" +
      "windows_net_current_bandwidth_bytes|" +
      "windows_net_packets_outbound_discarded_total|" +
      "windows_net_packets_outbound_errors_total|" +
      "windows_net_packets_received_discarded_total|" +
      "windows_net_packets_received_errors_total"
  }

  rule {
    source_labels = ["volume"]
    regex         = "^([A-Z]:|)$"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "windows-exporter"
  }
}

// Host info extractor: adiciona informações do SO do servidor Windows
prometheus.relabel "pull_windows_mssql_host_info" {
  forward_to = [prometheus.remote_write.pull_windows_mssql_host_gateway.receiver]

  // Para windows_os_info: adiciona os = "windows"
  rule {
    source_labels = ["__name__"]
    regex         = "windows_os_info"
    target_label  = "os"
    replacement   = "windows"
  }

  // Para windows_os_info: product → os_product
  rule {
    source_labels = ["__name__", "product"]
    regex         = "windows_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  // Para windows_os_info: version → os_version
  rule {
    source_labels = ["__name__", "version"]
    regex         = "windows_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}


// =============================================================================
// MSSQL SERVER
// =============================================================================

// Transformer (relabel): mantém apenas métricas do SQL Server (coletor mssql do
// windows_exporter) e adiciona service_name.
prometheus.relabel "pull_windows_mssql_host_db_transformer" {
  forward_to = [prometheus.remote_write.pull_windows_mssql_host_gateway.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // MSSQL Core
      "windows_mssql_instance_info|" +
      "windows_mssql_collector_success|" +

      // MSSQL Memory & Buffer
      "windows_mssql_memmgr_total_server_memory_bytes|" +
      "windows_mssql_memmgr_target_server_memory_bytes|" +
      "windows_mssql_bufman_page_reads|" +
      "windows_mssql_bufman_page_writes|" +
      "windows_mssql_bufman_page_life_expectancy_seconds|" +
      "windows_mssql_bufman_buffer_cache_hits|" +
      "windows_mssql_bufman_buffer_cache_lookups|" +

      // MSSQL Stats & Errors
      "windows_mssql_sqlstats_sql_compilations|" +
      "windows_mssql_sqlstats_sql_recompilations|" +
      "windows_mssql_sql_errors_total|" +
      "windows_mssql_genstats_user_connections|" +
      "windows_mssql_genstats_blocked_processes|" +
      "windows_mssql_waitstats_wait_for_the_worker_waits|" +

      // MSSQL Databases & Locks
      "windows_mssql_databases_log_growths|" +
      "windows_mssql_databases_log_used_percent|" +
      "windows_mssql_databases_transactions|" +
      "windows_mssql_locks_deadlocks"
  }

  rule {
    target_label = "service_name"
    replacement  = "mssql-exporter"
  }
}


// =============================================================================
// ENDPOINT
// =============================================================================

prometheus.remote_write "pull_windows_mssql_host_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

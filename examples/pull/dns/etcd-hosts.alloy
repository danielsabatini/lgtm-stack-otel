// =============================================================================
// PULL LEGADO — etcd remoto (sem Alloy agent)
//
// Coleta métricas do etcd via scrape HTTP direto (:2379, endpoint /metrics
// exposto nativamente no client port — https://etcd.io/docs/v3.7/metrics/).
// Indicado para servidores legados onde não é possível instalar o Alloy agent.
//
// Como usar:
//   Copie este arquivo para alloy-gateway/conf.d/ e reinicie o Alloy Gateway.
//   Adicione um bloco por servidor na lista targets abaixo — um bloco por
//   réplica do cluster etcd (esperado: 3 por região).
//   IMPORTANTE: Substitua as variáveis [IP_ADDRESS] pelo IP/porta real do host e [INSTANCE_NAME] por um nome único para a instância.
//   Os valores de environment, cloud_provider, cloud_region e cloud_availability_zone são padrões para produção no Magalu Cloud (br-se1 zona a) e devem ser alterados conforme a necessidade.
//
//   Se o mesmo host também roda CoreDNS (solução de DNS interno) e/ou o
//   node_exporter, use o mesmo [INSTANCE_NAME] nos arquivos
//   pull-coredns-hosts.alloy / pull-linux-hosts.alloy correspondentes — os
//   dashboards de DNS interno filtram host + etcd + CoreDNS por um único
//   $instance, simulando os três serviços rodando juntos no mesmo host.
// =============================================================================

prometheus.scrape "pull_etcd" {
  targets = [
    {
      "__address__"             = "[IP_ADDRESS]:2379",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "[REGION]",
      "cloud_availability_zone" = "[ZONE]",
    },
    {
      "__address__"             = "[IP_ADDRESS]:2379",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "[REGION]",
      "cloud_availability_zone" = "[ZONE]",
    },
    {
      "__address__"             = "[IP_ADDRESS]:2379",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "[REGION]",
      "cloud_availability_zone" = "[ZONE]",
    },
  ]

  metrics_path    = "/metrics"
  job_name        = "etcd"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.pull_etcd_transformer.receiver]
}

// Transformer (relabel): mantém apenas as métricas usadas pelo dashboard etcd
// (liderança/consenso Raft, disco, rede entre peers, tamanho do banco MVCC —
// ver etcd.io/docs/v3.7/metrics) e adiciona service_name para identificação
// no Grafana/Mimir.
prometheus.relabel "pull_etcd_transformer" {
  forward_to = [prometheus.remote_write.pull_etcd_gateway.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         =
      // Liderança & consenso Raft
      "up|" +
      "etcd_server_has_leader|" +
      "etcd_server_is_leader|" +
      "etcd_server_leader_changes_seen_total|" +
      "etcd_server_proposals_committed_total|" +
      "etcd_server_proposals_failed_total|" +

      // Inventário — fatos estáticos, mudam só em upgrade/reconfiguração.
      // Alimentam a tab Inventory do dashboard (ver docs/OBSERVABILITY-METHODOLOGY.md).
      "etcd_server_version|" +
      "etcd_cluster_version|" +
      "etcd_server_go_version|" +
      "process_start_time_seconds|" +

      // Storage (MVCC) — tamanho físico alocado vs em uso; gap grande entre
      // os dois indica fragmentação do banco bbolt (necessidade de defrag).
      // quota_backend_bytes é o denominador: sem ele o painel de tamanho do
      // banco mostra um absoluto sem referência de quanto ainda cabe.
      "etcd_server_quota_backend_bytes|" +
      "etcd_mvcc_db_total_size_in_bytes|" +
      "etcd_mvcc_db_total_size_in_use_in_bytes|" +
      "etcd_debugging_mvcc_keys_total|" +

      // Disco — latência de fsync do WAL e commit do backend
      "etcd_disk_wal_fsync_duration_seconds_bucket|" +
      "etcd_disk_wal_fsync_duration_seconds_count|" +
      "etcd_disk_wal_fsync_duration_seconds_sum|" +
      "etcd_disk_backend_commit_duration_seconds_bucket|" +
      "etcd_disk_backend_commit_duration_seconds_count|" +
      "etcd_disk_backend_commit_duration_seconds_sum|" +

      // Rede entre peers do cluster
      "etcd_network_peer_round_trip_time_seconds_bucket|" +
      "etcd_network_peer_round_trip_time_seconds_count|" +
      "etcd_network_peer_round_trip_time_seconds_sum"
  }

  rule {
    target_label = "service_name"
    replacement  = "etcd"
  }
}

prometheus.remote_write "pull_etcd_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

// =============================================================================
// PULL LEGADO — etcd dos Servidores de DNS Interno (MGC br-ne1)
//
// Coleta métricas do etcd via scrape HTTP direto (:2379) nos 3 servidores
// do cluster de DNS interno (172.18.1.2, 172.18.17.2 e 172.18.33.2).
//
// Como usar:
//   Copie este arquivo para alloy-gateway/conf.d/ e reinicie o Alloy Gateway.
// =============================================================================

prometheus.scrape "pull_etcd" {
  targets = [
    {
      "__address__"             = "172.18.1.2:2379",
      "instance"                = "dns-ne1-1",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-ne1",
      "cloud_availability_zone" = "a",
    },
    {
      "__address__"             = "172.18.17.2:2379",
      "instance"                = "dns-ne1-2",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-ne1",
      "cloud_availability_zone" = "b",
    },
    {
      "__address__"             = "172.18.33.2:2379",
      "instance"                = "dns-ne1-3",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-ne1",
      "cloud_availability_zone" = "c",
    },
  ]

  metrics_path    = "/metrics"
  job_name        = "etcd"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.pull_etcd_transformer.receiver]
}

// Transformer (relabel): mantém apenas as métricas usadas pelo dashboard etcd
prometheus.relabel "pull_etcd_transformer" {
  forward_to = [prometheus.remote_write.pull_etcd_gateway.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         =
      // Liderança & consenso Raft
      "up|" +
      "etcd_server_has_leader|" +
      "etcd_server_is_leader|" +
      "etcd_server_leader_changes_seen_total|" +
      "etcd_server_proposals_committed_total|" +
      "etcd_server_proposals_failed_total|" +

      // Inventário
      "etcd_server_version|" +
      "etcd_cluster_version|" +
      "etcd_server_go_version|" +
      "process_start_time_seconds|" +

      // Storage (MVCC)
      "etcd_server_quota_backend_bytes|" +
      "etcd_mvcc_db_total_size_in_bytes|" +
      "etcd_mvcc_db_total_size_in_use_in_bytes|" +
      "etcd_debugging_mvcc_keys_total|" +

      // Disco — latência de fsync do WAL e commit do backend
      "etcd_disk_wal_fsync_duration_seconds_bucket|" +
      "etcd_disk_wal_fsync_duration_seconds_count|" +
      "etcd_disk_wal_fsync_duration_seconds_sum|" +
      "etcd_disk_backend_commit_duration_seconds_bucket|" +
      "etcd_disk_backend_commit_duration_seconds_count|" +
      "etcd_disk_backend_commit_duration_seconds_sum|" +

      // Rede entre peers do cluster
      "etcd_network_peer_round_trip_time_seconds_bucket|" +
      "etcd_network_peer_round_trip_time_seconds_count|" +
      "etcd_network_peer_round_trip_time_seconds_sum"
  }

  rule {
    target_label = "service_name"
    replacement  = "etcd"
  }
}

prometheus.remote_write "pull_etcd_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

// =============================================================================
// PULL LEGADO — node_exporter remoto (sem Alloy agent)
//
// Coleta as mesmas métricas configuradas em alloy-agent/conf.d/001-metric-node-local.alloy,
// mas via scrape HTTP direto no node_exporter (:9100) no lugar de push.
// Indicado para servidores legados onde não é possível instalar o Alloy agent.
//
// Como usar:
//   Copie este arquivo para alloy-gateway/conf.d/ e reinicie o Alloy Gateway.
//   Adicione um bloco por servidor na lista targets abaixo.
//
// LIMITAÇÃO — Logs:
//   O node_exporter padrão não expõe logs. Para coletar SSH, kernel, cron e
//   systemd (equivalente a alloy-agent/conf.d/200-*.alloy … 275-*.alloy), instale
//   o Alloy agent no servidor remoto seguindo examples/linux/INSTALL.md.
//
//   IMPORTANTE: Substitua as variáveis [IP_ADDRESS] pelo IP/porta real do host e [INSTANCE_NAME] por um nome único para a instância.
//   Os valores de environment, cloud_provider, cloud_region e cloud_availability_zone são padrões para produção no Magalu Cloud (br-se1 zona a) e devem ser alterados conforme a necessidade.
// =============================================================================

// Collector (scrape): varre o node_exporter de cada servidor legado.
// Os labels de identidade (instance, environment, etc.) são definidos por target
// porque o gateway não possui as variáveis de ambiente do agent.
prometheus.scrape "linux_legacy" {
  targets = [
    {
      "__address__"             = "[IP_ADDRESS]:9100",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "[IP_ADDRESS]:9100",
    //   "instance"                = "[INSTANCE_NAME]",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "linux-legacy"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.linux_legacy_transformer.receiver]
}

// Transformer (relabel): mantém apenas as mesmas métricas coletadas pelo Alloy agent
// e adiciona o label service_name para identificação no Grafana/Mimir.
prometheus.relabel "linux_legacy_transformer" {
  forward_to = [prometheus.relabel.linux_legacy_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // Core & Metadata
      "node_boot_time_seconds|" +
      "node_uname_info|" +
      "node_os_info|" +

      // CPU & Load
      "node_cpu_seconds_total|" +
      "node_load1|" +
      "node_load5|" +
      "node_load15|" +

      // Memory
      "node_memory_Buffers_bytes|" +
      "node_memory_Cached_bytes|" +
      "node_memory_MemAvailable_bytes|" +
      "node_memory_MemFree_bytes|" +
      "node_memory_MemTotal_bytes|" +
      "node_memory_SReclaimable_bytes|" +
      "node_memory_SwapFree_bytes|" +
      "node_memory_SwapTotal_bytes|" +

      // System Pressure
      "node_pressure_cpu.*|" +
      "node_pressure_io.*|" +
      "node_pressure_memory.*|" +

      // Disk & Filesystem
      "node_disk_read.*|" +
      "node_disk_write.*|" +
      "node_disk_written.*|" +
      "node_disk_io_time.*|" +
      "node_filesystem_avail_bytes|" +
      "node_filesystem_files|" +
      "node_filesystem_files_free|" +
      "node_filesystem_free_bytes|" +
      "node_filesystem_size_bytes|" +

      // Network
      "node_network_receive_bytes_total|" +
      "node_network_receive_drop_total|" +
      "node_network_receive_errs_total|" +
      "node_network_speed_bytes|" +
      "node_network_transmit_bytes_total|" +
      "node_network_transmit_drop_total|" +
      "node_network_transmit_errs_total"
  }


  rule {
    source_labels = ["device"]
    regex         = "^(loop|ram|fd|sr)[0-9]*$|^dm-[0-9]+$"
    action        = "drop"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}

// Host info extractor: renomeia labels da métrica node_uname_info para valores mais intuitivos
prometheus.relabel "linux_legacy_host_info" {
  forward_to = [prometheus.remote_write.linux_legacy_gateway.receiver]

  // Para node_uname_info: sysname → os (lowercase)
  rule {
    source_labels = ["__name__", "sysname"]
    regex         = "node_uname_info;(.*)"
    target_label  = "os"
    replacement   = "$1"
  }

  rule {
    source_labels = ["os"]
    target_label  = "os"
    action        = "lowercase"
  }

  // Para node_uname_info: machine → architecture
  rule {
    source_labels = ["__name__", "machine"]
    regex         = "node_uname_info;(.*)"
    target_label  = "architecture"
    replacement   = "$1"
  }

  // Para node_uname_info: release → kernel_release
  rule {
    source_labels = ["__name__", "release"]
    regex         = "node_uname_info;(.*)"
    target_label  = "kernel_release"
    replacement   = "$1"
  }

  // Para node_os_info: name → os_product
  rule {
    source_labels = ["__name__", "name"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  // Para node_os_info: version_id → os_version
  rule {
    source_labels = ["__name__", "version_id"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}

prometheus.remote_write "linux_legacy_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

// =============================================================================
// EXEMPLO ALLOY GATEWAY - PULL DE WINDOWS_EXPORTER LEGADO
// 
// Como Usar:
// Copie este arquivo para 'lgtm-stack/alloy-gateway/conf.d/' e reinicie o Gateway.
// Esta configuração faz o scraping de servidores Windows com o agent clássico 
// rodando na porta 9182.
// =============================================================================

prometheus.scrape "pull_windows_legado" {
  // Lista EXPLÍCITA de servidores legados na porta padrão do windows_exporter
  targets = [
    {"__address__" = "10.0.0.99:9182", "instance" = "win-ad-server"},
  ]

  job_name        = "windows-legacy"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.windows_legacy_transformer.receiver]
}

// Transformer (relabel): mantém apenas as mesmas métricas coletadas pelo Alloy agent
// e adiciona labels de identidade do host.
prometheus.relabel "windows_legacy_transformer" {
  forward_to = [prometheus.relabel.windows_legacy_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "^windows_(cpu|logical_disk|net|os|system|memory)_.*$"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "windows-exporter"
  }
}

// Host info extractor: adiciona informações do SO do servidor Windows
prometheus.relabel "windows_legacy_host_info" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  // Para windows_os_info: adiciona os = "windows"
  rule {
    source_labels = ["__name__"]
    regex         = "windows_os_info"
    target_label  = "os"
    replacement   = "windows"
  }

  // Para windows_os_info: product → os_product
  rule {
    source_labels = ["__name__", "product"]
    regex         = "windows_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  // Para windows_os_info: version → os_version
  rule {
    source_labels = ["__name__", "version"]
    regex         = "windows_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}

// =============================================================================
// EXEMPLO ALLOY GATEWAY - PULL DE POSTGRES_EXPORTER LEGADO
// 
// Como Usar:
// Copie este arquivo para 'lgtm-stack/alloy-gateway/conf.d/' e reinicie o Gateway.
// Esta configuração faz o scraping de instâncias com postgres_exporter ativo
// cortando métricas absurdas que quebram o TSDB.
// =============================================================================

prometheus.scrape "pull_postgres_legado" {
  // Lista EXPLÍCITA de alvos da Porta padrão do PostgreSQL Exporter 
  targets = [
    {"__address__" = "10.0.0.100:9187", "instance" = "db-pessoas"},
  ]

  job_name        = "postgres-legacy"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.mimir.receiver]

  // =========================================================
  // VÁLVULA DE SEGURANÇA (Relabeling PostgreSQL Minimal)
  // =========================================================
  // Idêntico ao parâmetro Push: ["database", "locks", "stat_user_tables"]
  metric_relabel {
    source_labels = ["__name__"]
    regex         = "^pg_(database|locks|stat_user_tables)_.*$"
    action        = "keep"
  }
}

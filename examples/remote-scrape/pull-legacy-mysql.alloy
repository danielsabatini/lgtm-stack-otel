// =============================================================================
// EXEMPLO ALLOY GATEWAY - PULL DE MYSQL_EXPORTER LEGADO
// 
// Como Usar:
// Copie este arquivo para 'lgtm-stack/alloy-gateway/conf.d/' e reinicie o Gateway.
// Esta configuração faz o scraping de um mysqld_exporter genérico/legado remoto,
// e tritura as telemetrias inúteis em RAM salvando do HD do Mimir.
// =============================================================================

prometheus.scrape "pull_mysql_legado" {
  // Lista EXPLÍCITA de alvos da Porta oficial do MySQL Exporter 
  targets = [
    {"__address__" = "10.0.0.88:9104", "instance" = "db-faturamento"},
  ]

  job_name        = "mysql-legacy"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.mimir.receiver]

  // =========================================================
  // VÁLVULA DE SEGURANÇA (Relabeling MySQL Minimal)
  // =========================================================
  metric_relabel {
    source_labels = ["__name__"]
    // Permite "keep" apenas das famílias idênticas ao agente local (Push)
    regex         = "^mysql_(global_status|global_variables|innodb)_.*$"
    action        = "keep"
  }
}

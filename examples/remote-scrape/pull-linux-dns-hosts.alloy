// =============================================================================
// PULL LEGADO — node_exporter dos Servidores de DNS Interno (MGC br-ne1)
//
// Coleta métricas do node_exporter (:9100) via scrape HTTP direto nos 3
// servidores de DNS interno (172.18.1.2, 172.18.17.2 e 172.18.33.2).
//
// Como usar:
//   Copie este arquivo para alloy-gateway/conf.d/ e reinicie o Alloy Gateway.
// =============================================================================

prometheus.scrape "pull_linux_host" {
  targets = [
    {
      "__address__"             = "172.18.1.2:9100",
      "instance"                = "dns-ne1-1",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-ne1",
      "cloud_availability_zone" = "a",
    },
    {
      "__address__"             = "172.18.17.2:9100",
      "instance"                = "dns-ne1-2",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-ne1",
      "cloud_availability_zone" = "b",
    },
    {
      "__address__"             = "172.18.33.2:9100",
      "instance"                = "dns-ne1-3",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-ne1",
      "cloud_availability_zone" = "c",
    },
  ]

  job_name        = "linux-legacy"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.pull_linux_host_transformer.receiver]
}

// Transformer (relabel): mantém apenas as métricas usadas pelo dashboard Linux
prometheus.relabel "pull_linux_host_transformer" {
  forward_to = [prometheus.relabel.pull_linux_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         =
      // Disponibilidade do target
      "up|" +

      // Core & Metadata
      "node_boot_time_seconds|" +
      "node_uname_info|" +
      "node_os_info|" +

      // CPU & Load
      "node_cpu_seconds_total|" +
      "node_load1|" +
      "node_load5|" +
      "node_load15|" +

      // Memory
      "node_memory_Buffers_bytes|" +
      "node_memory_Cached_bytes|" +
      "node_memory_MemAvailable_bytes|" +
      "node_memory_MemFree_bytes|" +
      "node_memory_MemTotal_bytes|" +
      "node_memory_SReclaimable_bytes|" +
      "node_memory_SwapFree_bytes|" +
      "node_memory_SwapTotal_bytes|" +

      // System Pressure
      "node_pressure_cpu.*|" +
      "node_pressure_io.*|" +
      "node_pressure_memory.*|" +

      // Disk & Filesystem
      "node_disk_read.*|" +
      "node_disk_write.*|" +
      "node_disk_written.*|" +
      "node_disk_io_time.*|" +
      "node_filesystem_avail_bytes|" +
      "node_filesystem_files|" +
      "node_filesystem_files_free|" +
      "node_filesystem_free_bytes|" +
      "node_filesystem_size_bytes|" +

      // Network
      "node_network_receive_bytes_total|" +
      "node_network_receive_drop_total|" +
      "node_network_receive_errs_total|" +
      "node_network_speed_bytes|" +
      "node_network_transmit_bytes_total|" +
      "node_network_transmit_drop_total|" +
      "node_network_transmit_errs_total"
  }

  rule {
    source_labels = ["device"]
    regex         = "^(loop|ram|fd|sr)[0-9]*$|^dm-[0-9]+$"
    action        = "drop"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}

// Host info extractor: normaliza metadados do sistema operacional
prometheus.relabel "pull_linux_host_info" {
  forward_to = [prometheus.remote_write.pull_linux_host_gateway.receiver]

  rule {
    source_labels = ["__name__", "sysname"]
    regex         = "node_uname_info;(.*)"
    target_label  = "os"
    replacement   = "$1"
  }

  rule {
    source_labels = ["os"]
    target_label  = "os"
    action        = "lowercase"
  }

  rule {
    source_labels = ["__name__", "machine"]
    regex         = "node_uname_info;(.*)"
    target_label  = "architecture"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__name__", "release"]
    regex         = "node_uname_info;(.*)"
    target_label  = "kernel_release"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__name__", "name"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__name__", "version_id"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}

prometheus.remote_write "pull_linux_host_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

// =============================================================================
// PULL LEGADO — node_exporter + postgres_exporter remoto
//
// Coleta métricas de SO (node) e banco de dados (postgres) via scrape HTTP direto.
// Indicado para servidores legados onde não é possível instalar o Alloy agent.
//
// Como usar:
//   Copie este arquivo para alloy-gateway/conf.d/ e reinicie o Alloy Gateway.
//   Adicione um bloco por servidor nas listas targets abaixo.
//   IMPORTANTE: Substitua as variáveis [IP_ADDRESS] pelo IP/porta real do host e [INSTANCE_NAME] por um nome único para a instância.
//   Os valores de environment, cloud_provider, cloud_region e cloud_availability_zone são padrões para produção no Magalu Cloud (br-se1 zona a) e devem ser alterados conforme a necessidade.
// =============================================================================

// -----------------------------------------------------------------------------
// NODE METRICS
// -----------------------------------------------------------------------------
prometheus.scrape "linux_pgsql_node" {
  targets = [
    {
      "__address__"             = "[IP_ADDRESS]:8080",
      "__metrics_path__"        = "/node/metrics",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "[IP_ADDRESS]:8080",
    //   "__metrics_path__"        = "/node/metrics",
    //   "instance"                = "[INSTANCE_NAME]",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "linux-node"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.linux_pgsql_node_transformer.receiver]
}

prometheus.relabel "linux_pgsql_node_transformer" {
  forward_to = [prometheus.relabel.linux_pgsql_node_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // Core & Metadata
      "node_boot_time_seconds|" +
      "node_uname_info|" +
      "node_os_info|" +

      // CPU & Load
      "node_cpu_seconds_total|" +
      "node_load1|" +
      "node_load5|" +
      "node_load15|" +

      // Memory
      "node_memory_Cached_bytes|" +
      "node_memory_MemFree_bytes|" +
      "node_memory_MemTotal_bytes|" +
      "node_memory_SwapFree_bytes|" +
      "node_memory_SwapTotal_bytes|" +

      // System Pressure
      "node_pressure_cpu_waiting_seconds_total|" +
      "node_pressure_io_waiting_seconds_total|" +
      "node_pressure_memory_waiting_seconds_total|" +

      // Disk & Filesystem
      "node_disk_read_bytes_total|" +
      "node_disk_read_time_seconds_total|" +
      "node_disk_reads_completed_total|" +
      "node_disk_write_time_seconds_total|" +
      "node_disk_writes_completed_total|" +
      "node_disk_written_bytes_total|" +
      "node_filesystem_avail_bytes|" +
      "node_filesystem_files|" +
      "node_filesystem_files_free|" +
      "node_filesystem_size_bytes|" +

      // Network
      "node_network_receive_bytes_total|" +
      "node_network_receive_drop_total|" +
      "node_network_receive_errs_total|" +
      "node_network_transmit_bytes_total|" +
      "node_network_transmit_drop_total|" +
      "node_network_transmit_errs_total"
  }

  rule {
    source_labels = ["device"]
    regex         = "^(loop|ram|fd|sr)[0-9]*$|^dm-[0-9]+$"
    action        = "drop"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}

prometheus.relabel "linux_pgsql_node_host_info" {
  forward_to = [prometheus.remote_write.linux_pgsql_gateway.receiver]

  // Para node_uname_info: sysname → os (lowercase)
  rule {
    source_labels = ["__name__", "sysname"]
    regex         = "node_uname_info;(.*)"
    target_label  = "os"
    replacement   = "$1"
  }

  rule {
    source_labels = ["os"]
    target_label  = "os"
    action        = "lowercase"
  }

  // Para node_uname_info: machine → architecture
  rule {
    source_labels = ["__name__", "machine"]
    regex         = "node_uname_info;(.*)"
    target_label  = "architecture"
    replacement   = "$1"
  }

  // Para node_uname_info: release → kernel_release
  rule {
    source_labels = ["__name__", "release"]
    regex         = "node_uname_info;(.*)"
    target_label  = "kernel_release"
    replacement   = "$1"
  }

  // Para node_os_info: name → os_product
  rule {
    source_labels = ["__name__", "name"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  // Para node_os_info: version_id → os_version
  rule {
    source_labels = ["__name__", "version_id"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}

// -----------------------------------------------------------------------------
// POSTGRESQL METRICS
// -----------------------------------------------------------------------------
prometheus.scrape "linux_pgsql_db" {
  targets = [
    {
      "__address__"             = "[IP_ADDRESS]:8080",
      "__metrics_path__"        = "/postgres/metrics",
      "instance"                = "[INSTANCE_NAME]",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "[IP_ADDRESS]:8080",
    //   "__metrics_path__"        = "/postgres/metrics",
    //   "instance"                = "[INSTANCE_NAME]",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "linux-postgres"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.linux_pgsql_db_transformer.receiver]
}

prometheus.relabel "linux_pgsql_db_transformer" {
  forward_to = [prometheus.remote_write.linux_pgsql_gateway.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      "pg_up|" +
      "pg_settings_max_connections|" +
      "pg_stat_activity_count|" +
      "pg_database_size_bytes|" +
      "pg_wal_size_bytes|" +
      "pg_stat_database_temp_bytes|" +
      "pg_stat_database_xact_commit|" +
      "pg_stat_database_xact_rollback|" +
      "pg_stat_database_numbackends|" +
      "pg_stat_database_tup_returned|" +
      "pg_stat_database_tup_fetched|" +
      "pg_stat_database_tup_inserted|" +
      "pg_stat_database_tup_updated|" +
      "pg_stat_database_tup_deleted|" +
      "pg_stat_database_deadlocks|" +
      "pg_static"
  }

  rule {
    target_label = "service_name"
    replacement  = "postgres-exporter"
  }

  // O postgres_exporter nativamente exporta um label chamado "server" (ex: server="127.0.0.1:5432").
  // Como utilizamos apenas a label "instance" para os painéis, vamos descartar a label "server" 
  // para evitar duplicação ou poluição de labels, mantendo apenas "instance" = "[INSTANCE_NAME]".
  rule {
    regex  = "server"
    action = "labeldrop"
  }
}

// -----------------------------------------------------------------------------
// REMOTE WRITE
// -----------------------------------------------------------------------------
prometheus.remote_write "linux_pgsql_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

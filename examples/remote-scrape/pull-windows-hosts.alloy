// =============================================================================
// EXEMPLO ALLOY GATEWAY - PULL DE WINDOWS_EXPORTER LEGADO
// 
// Como Usar:
// Copie este arquivo para 'lgtm-stack/alloy-gateway/conf.d/' e reinicie o Gateway.
// Esta configuração faz o scraping de servidores Windows com o agent clássico 
// rodando na porta 9182.
// =============================================================================

prometheus.scrape "pull_windows_legado" {
  // Lista EXPLÍCITA de servidores legados na porta padrão do windows_exporter
  targets = [
    {
      "__address__"             = "10.0.0.99:9182",
      "instance"                = "win-ad-server",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "10.0.0.100:9182",
    //   "instance"                = "win-srv-02",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "windows-legacy"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.windows_legacy_transformer.receiver]
}

// Transformer (relabel): mantém apenas as mesmas métricas coletadas pelo Alloy agent
// e adiciona labels de identidade do host.
prometheus.relabel "windows_legacy_transformer" {
  forward_to = [prometheus.relabel.windows_legacy_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // Core & System
      "windows_system_boot_time_timestamp|" +
      "windows_os_info|" +

      // CPU & System
      "windows_cpu_time_total|" +
      "windows_system_boot_time_timestamp|" +
      "windows_system_processor_queue_length|" +

      // Memory
      "windows_memory_physical_total_bytes|" +
      "windows_memory_available_bytes|" +
      "windows_memory_cache_bytes|" +

      // Pagefile
      "windows_pagefile_limit_bytes|" +
      "windows_pagefile_free_bytes|" +

      // Disk & Filesystem
      "windows_logical_disk_size_bytes|" +
      "windows_logical_disk_free_bytes|" +
      "windows_logical_disk_read_bytes_total|" +
      "windows_logical_disk_reads_total|" +
      "windows_logical_disk_write_bytes_total|" +
      "windows_logical_disk_writes_total|" +

      // Network
      "windows_net_bytes_total|" +
      "windows_net_bytes_received_total|" +
      "windows_net_bytes_sent_total|" +
      "windows_net_current_bandwidth_bytes|" +
      "windows_net_packets_outbound_discarded_total|" +
      "windows_net_packets_outbound_errors_total|" +
      "windows_net_packets_received_discarded_total|" +
      "windows_net_packets_received_errors_total"
  }


  rule {
    source_labels = ["volume"]
    regex         = "^([A-Z]:|)$"
    action        = "keep"
  }

  rule {
    target_label = "service_name"
    replacement  = "windows-exporter"
  }
}

// Host info extractor: adiciona informações do SO do servidor Windows
prometheus.relabel "windows_legacy_host_info" {
  forward_to = [prometheus.remote_write.windows_legacy_gateway.receiver]

  // Para windows_os_info: adiciona os = "windows"
  rule {
    source_labels = ["__name__"]
    regex         = "windows_os_info"
    target_label  = "os"
    replacement   = "windows"
  }

  // Para windows_os_info: product → os_product
  rule {
    source_labels = ["__name__", "product"]
    regex         = "windows_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  // Para windows_os_info: version → os_version
  rule {
    source_labels = ["__name__", "version"]
    regex         = "windows_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}

prometheus.remote_write "windows_legacy_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

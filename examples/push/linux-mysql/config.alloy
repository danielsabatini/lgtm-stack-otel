// =============================================================================
// EXEMPLO ALLOY AGENT: MYSQL / MARIADB (LEAN)
// Foco: Banco de Dados de Alta Performance, expurgando metrics granulares inúteis.
// Aviso de Traces: Bancos de Dados não operam Traces diretamente via agent.
// =============================================================================

// =============================================================================
// 0. ALLOY SELF (saúde do próprio agente)
// =============================================================================
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.relabel.alloy_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "alloy_labels" {
  forward_to = [prometheus.relabel.global_identity.receiver]

  rule {
    target_label = "service_name"
    replacement  = "alloy"
  }
}

// =============================================================================
// 1. MÉTRICAS (Mínimas Necessárias)
// =============================================================================
prometheus.exporter.mysql "db_mysql" {
  // Credencial NUNCA deve ficar hardcoded neste arquivo. Exporte a variável
  // de ambiente antes de subir o Alloy, ex:
  //   export MYSQL_EXPORTER_DSN="alloy_exporter:senha_segura@(localhost:3306)/"
  // O user precisa ter os privilégios REPLICATION CLIENT e PROCESS.
  data_source_name = sys.env("MYSQL_EXPORTER_DSN")

  // Restrição estrita de cardinalidade: Pegar apenas estatísticas Globais e de Engine.
  // Evitará a coleta de schemas complexos ou events statements que esmagam o Mimir.
  set_collectors = [
    "global_status",
    "global_variables",
    "innodb",
  ]
}

prometheus.scrape "mysql_metrics" {
  targets         = prometheus.exporter.mysql.db_mysql.targets
  job_name        = "mysql-cluster"
  scrape_interval = "60s"

  forward_to      = [prometheus.relabel.mysql_labels.receiver]
}

prometheus.relabel "mysql_labels" {
  forward_to = [prometheus.relabel.global_identity.receiver]

  rule {
    target_label = "service_name"
    replacement  = "mysqld-exporter"
  }
}

// Identidade global — mesmos labels usados nos demais templates (linux, windows,
// windows-mssql), necessários para o $instance dos dashboards e para correlação
// entre métricas/logs/traces no Grafana Explore.
// TODO: ajuste environment/cloud_provider/cloud_region/cloud_availability_zone
// conforme o ambiente real deste host.
prometheus.relabel "global_identity" {
  forward_to = [prometheus.remote_write.gateway.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }

  rule {
    target_label = "environment"
    replacement  = "prd"
  }

  rule {
    target_label = "cloud_provider"
    replacement  = "mgc"
  }

  rule {
    target_label = "cloud_region"
    replacement  = "br-se1"
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = "a"
  }
}

prometheus.remote_write "gateway" {
  endpoint {
    url = "http://lgtm-stack:9999/api/v1/metrics/write"
  }
}

// =============================================================================
// 2. LOGS DO SO (Filtro por Arquivo Oficial do Engine)
// =============================================================================
local.file_match "mysql_logs" {
  // Ao invez de sugar o Syslog geral, miramos com laser no que importa
  path_targets = [
    {"__path__" = "/var/log/mysql/error.log"},
  ]
}

loki.source.file "mysql" {
  targets    = local.file_match.mysql_logs.targets
  forward_to = [loki.relabel.mysql_format.receiver]
}

loki.relabel "mysql_format" {
  forward_to = [loki.relabel.global_identity_logs.receiver]
  rule {
    target_label = "service_name"
    replacement  = "mysql"
  }
}

loki.relabel "global_identity_logs" {
  forward_to = [loki.write.gateway_logs.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("HOSTNAME")
  }

  rule {
    target_label = "environment"
    replacement  = "prd"
  }

  rule {
    target_label = "cloud_provider"
    replacement  = "mgc"
  }

  rule {
    target_label = "cloud_region"
    replacement  = "br-se1"
  }

  rule {
    target_label = "cloud_availability_zone"
    replacement  = "a"
  }
}

loki.write "gateway_logs" {
  endpoint {
    url = "http://lgtm-stack:9998/loki/api/v1/push"
  }
}

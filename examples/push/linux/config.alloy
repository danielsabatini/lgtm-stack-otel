   }
 }
}


// -------------------- TRACES: Beyla eBPF (Opcional) --------------------
// Referência: https://grafana.com/docs/alloy/latest/reference/components/beyla/beyla.ebpf/

beyla.ebpf "app_instrument" {
  // Falha alto e cedo se faltar alguma capability eBPF, em vez de degradar
  // silenciosamente (ver INSTALL.md, seção "Traces (Beyla eBPF) — Opcional").
  enforce_sys_caps = true

  // Propagação de contexto distribuído injetada pelo kernel (eBPF), sem nenhuma
  // linha de instrumentação no código da aplicação. É isto que costura serviços
  // que chamam uns aos outros sob um ÚNICO traceID.
  //
  // Sem este bloco, cada serviço gera um trace isolado: você vê spans, mas não
  // vê a cadeia. Se o host roda um serviço único, sem chamadas HTTP de saída
  // para outro serviço instrumentado, pode omitir.
  //
  // "headers" injeta apenas o cabeçalho HTTP `traceparent` (W3C Trace Context).
  // Suficiente para HTTP em texto claro e evita os programas de Linux Traffic
  // Control (TC) exigidos pelos modos "tcp"/"all" — necessários apenas para
  // HTTPS e capazes de conflitar com outros programas TC do host (ex: Cilium).
  ebpf {
    context_propagation = "headers"
  }

  discovery {
    // Um bloco `instrument` por serviço, sempre escopado por porta.
    // NUNCA instrumente o host inteiro sem filtro: o volume de spans e a
    // cardinalidade ficam impossíveis de prever.
    instrument {
      // TODO: ajuste a porta do seu serviço (ex: "8080", "80,443", "3000-3010")
      open_ports = "8080"

      // TODO: ajuste o nome lógico do serviço (aparece como service_name no Tempo/Grafana)
      name = "app"

      sampler {
        // NUNCA troque para um sampler por ratio (ex: "traceidratio") aqui.
        // O Alloy Gateway já aplica tail sampling (alloy-gateway/conf.d/003-otlp-gtw-local.alloy):
        // retém 100% de erros, 100% de traces >1000ms, e amostra 5% do restante "OK".
        // Se o Beyla descartar spans por ratio ANTES do gateway, a decisão é cega ao
        // status/latência e uma fração de erros/lentidão se perde para sempre.
        name = "always_on"
      }
    }

    // Exemplo opcional: replique o bloco acima para cada serviço adicional
    // deste host, de modo que cada um receba seu próprio service_name no Tempo.
    /*
    instrument {
      open_ports = "8081"
      name       = "middleware"

      sampler {
        // Ver justificativa no bloco anterior.
        name = "always_on"
      }
    }
    */
  }

  // Exemplo opcional: descomente e ajuste se o serviço expõe paths com segmentos
  // dinâmicos (IDs, UUIDs, slugs) para evitar explosão de cardinalidade em http.route.
  // `patterns` fixa o conjunto conhecido; `unmatched = "heuristic"` e o teto por
  // segmento permanecem como defesa para qualquer path fora da lista.
  /*
  routes {
    patterns                     = ["/api/v1/users/{id}", "/api/v1/orders/{id}"]
    unmatched                    = "heuristic"
    max_path_segment_cardinality = 10
  }
  */

  output {
    traces = [otelcol.processor.transform.global_identity_traces.input]
  }
}


// -------------------- GLOBAL LABELS --------------------

prometheus.relabel "host_info_extractor" {
 forward_to=[prometheus.relabel.global_identity.receiver]

 rule {
   source_labels=["__name__","sysname"]
   regex="node_uname_info;(.*)"
   target_label="os"
   replacement="$1"
 }

 rule {
   source_labels=["os"]
   target_label="os"
   action="lowercase"
 }

 rule {
   source_labels=["__name__","machine"]
   regex="node_uname_info;(.*)"
   target_label="architecture"
   replacement="$1"
 }

 rule {
   source_labels=["__name__","release"]
   regex="node_uname_info;(.*)"
   target_label="kernel_release"
   replacement="$1"
 }

 rule {
   source_labels=["__name__","name"]
   regex="node_os_info;(.*)"
   target_label="os_product"
   replacement="$1"
 }

 rule {
   source_labels=["__name__","version_id"]
   regex="node_os_info;(.*)"
   target_label="os_version"
   replacement="$1"
 }
}

prometheus.relabel "global_identity" {
 forward_to=[prometheus.remote_write.gateway.receiver]

 rule {
   target_label = "instance"
   replacement = sys.env("HOSTNAME")
 }
 rule {
   target_label = "environment"
   replacement = "prd"
 }
 rule {
   target_label = "cloud_provider"
   replacement = "mgc"
 }
 rule {
   target_label = "cloud_region"
   replacement = "br-se1"
 }
 rule {
   target_label = "cloud_availability_zone"
   replacement = "a"
 }
}

loki.relabel "global_identity" {
 forward_to=[loki.write.gateway.receiver]

 rule {
   target_label = "instance"
   replacement = sys.env("HOSTNAME")
 }
 rule {
   target_label = "environment"
   replacement = "prd"
 }
 rule {
   target_label = "cloud_provider"
   replacement = "mgc"
 }
 rule {
   target_label = "cloud_region"
   replacement = "br-se1"
 }
 rule {
   target_label = "cloud_availability_zone"
   replacement = "a"
 }
}

otelcol.processor.transform "global_identity_traces" {
  error_mode = "ignore"

  trace_statements {
    context = "resource"
    statements = [
      `set(attributes["instance"], "` + sys.env("HOSTNAME") + `")`,
      `set(attributes["environment"], "prd")`,
      `set(attributes["cloud_provider"], "mgc")`,
      `set(attributes["cloud_region"], "br-se1")`,
      `set(attributes["cloud_availability_zone"], "a")`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.traces_batch.input]
  }
}

otelcol.processor.batch "traces_batch" {
  output {
    traces = [otelcol.exporter.otlp.gateway_traces.input]
  }
}


// -------------------- OUTPUTS --------------------

prometheus.remote_write "gateway" {
 endpoint {
   url="http://lgtm-stack:9999/api/v1/metrics/write"
 }
}

loki.write "gateway" {
 endpoint {
   url="http://lgtm-stack:9998/loki/api/v1/push"
 }
}

otelcol.exporter.otlp "gateway_traces" {
  client {
    endpoint = "lgtm-stack:4317"

    tls {
      // TODO: ajuste conforme a política de TLS do seu ambiente.
      insecure = true
    }
  }
}

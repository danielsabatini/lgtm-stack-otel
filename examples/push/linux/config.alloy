// =============================================================================
// Grafana Alloy — Linux Single File Reference
// =============================================================================
//
// Traces (Beyla eBPF): seção opcional — requer kernel Linux >=5.8 com BTF e
// capabilities eBPF (ver INSTALL.md, seção "Traces (Beyla eBPF) — Opcional").
// Ajuste open_ports/name na seção TRACES antes de habilitar.
// =============================================================================

// -------------------- METRICS: Alloy Self --------------------

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.relabel.alloy_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "alloy_labels" {
  forward_to = [prometheus.relabel.host_info_extractor.receiver]

  rule {
    target_label = "service_name"
    replacement  = "alloy"
  }

  // Keep only Alloy self-metrics (Descomente apenas para Debug/Troubleshooting)
  /*
  rule {
    source_labels = ["__name__"]
    regex         = "alloy_.+"
    action        = "keep"
  }
  */
}


// -------------------- METRICS: Linux Host --------------------

prometheus.exporter.unix "host" {
  procfs_path = "/proc"
  sysfs_path  = "/sys"
  rootfs_path = "/"

  set_collectors = [
    "cpu",
    "diskstats",
    "filesystem",
    "meminfo",
    "netclass",
    "netdev",
    "loadavg",
    "uname",
    "stat",
    "os",
  ]
}

prometheus.scrape "linux_host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.linux_host_labels.receiver]
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.relabel "linux_host_labels" {
  forward_to = [prometheus.relabel.host_info_extractor.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = 
      // Core & Metadata
      "node_boot_time_seconds|" +
      "node_uname_info|" +
      "node_os_info|" +

      // CPU & Load
      "node_cpu_seconds_total|" +
      "node_load1|" +
      "node_load5|" +
      "node_load15|" +

      // Memory
      "node_memory_Buffers_bytes|" +
      "node_memory_Cached_bytes|" +
      "node_memory_MemAvailable_bytes|" +
      "node_memory_MemFree_bytes|" +
      "node_memory_MemTotal_bytes|" +
      "node_memory_SReclaimable_bytes|" +
      "node_memory_SwapFree_bytes|" +
      "node_memory_SwapTotal_bytes|" +

      // System Pressure
      "node_pressure_cpu.*|" +
      "node_pressure_io.*|" +
      "node_pressure_memory.*|" +

      // Disk & Filesystem
      "node_disk_read.*|" +
      "node_disk_write.*|" +
      "node_disk_written.*|" +
      "node_disk_io_time.*|" +
      "node_filesystem_avail_bytes|" +
      "node_filesystem_files|" +
      "node_filesystem_files_free|" +
      "node_filesystem_free_bytes|" +
      "node_filesystem_size_bytes|" +

      // Network
      "node_network_receive_bytes_total|" +
      "node_network_receive_drop_total|" +
      "node_network_receive_errs_total|" +
      "node_network_speed_bytes|" +
      "node_network_transmit_bytes_total|" +
      "node_network_transmit_drop_total|" +
      "node_network_transmit_errs_total"
  }

  rule {
    source_labels = ["device"]
    regex         = "^(loop|ram|fd|sr)[0-9]*$|^dm-[0-9]+$"
    action        = "drop"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}


// -------------------- LOGS: SSH --------------------

loki.relabel "ssh_journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }
}

loki.source.journal "ssh" {
  forward_to    = [loki.relabel.ssh_labels.receiver]
  matches       = "_SYSTEMD_UNIT=ssh.service"
  relabel_rules = loki.relabel.ssh_journal_labels.rules
}

loki.relabel "ssh_labels" {
  forward_to = [loki.process.ssh_normalize.receiver]

  rule {
    source_labels = ["priority"]
    regex = "[012]"
    target_label = "level"
    replacement = "critical"
  }
  rule {
    source_labels = ["priority"]
    regex = "3"
    target_label = "level"
    replacement = "error"
  }
  rule {
    source_labels = ["priority"]
    regex = "[45]"
    target_label = "level"
    replacement = "warn"
  }
  rule {
    source_labels = ["priority"]
    regex = "6"
    target_label = "level"
    replacement = "info"
  }
  rule {
    source_labels = ["priority"]
    regex = "7"
    target_label = "level"
    replacement = "debug"
  }

  rule {
    source_labels=["level"]
    regex="^$"
    target_label="level"
    replacement="unknown"
  }
}

loki.process "ssh_normalize" {
  forward_to = [loki.relabel.global_identity.receiver]

  stage.label_drop {
    values = ["priority","job"]
  }

  stage.static_labels {
    values = {
      category="security",
      service_name="ssh",
    }
  }
}


// -------------------- LOGS: Kernel --------------------

loki.relabel "kernel_journal_labels" {
 forward_to=[]
 rule {
   source_labels=["__journal_priority"]
   target_label="priority"
 }
}

loki.source.journal "kernel" {
 forward_to=[loki.relabel.kernel_labels.receiver]
 matches="_TRANSPORT=kernel"
 relabel_rules=loki.relabel.kernel_journal_labels.rules
}

loki.relabel "kernel_labels" {
 forward_to=[loki.process.kernel_normalize.receiver]

 rule {
   source_labels = ["priority"]
   regex = "[012]"
   target_label = "level"
   replacement = "critical"
 }
 rule {
   source_labels = ["priority"]
   regex = "3"
   target_label = "level"
   replacement = "error"
 }
 rule {
   source_labels = ["priority"]
   regex = "[45]"
   target_label = "level"
   replacement = "warn"
 }
 rule {
   source_labels = ["priority"]
   regex = "6"
   target_label = "level"
   replacement = "info"
 }
 rule {
   source_labels = ["priority"]
   regex = "7"
   target_label = "level"
   replacement = "debug"
 }

 rule {
   source_labels=["level"]
   regex="^$"
   target_label="level"
   replacement="unknown"
 }
}

loki.process "kernel_normalize" {
 forward_to=[loki.relabel.global_identity.receiver]

 stage.match {
   selector=`{level=~"info|debug"}`
   action="drop"
 }

 stage.label_drop {
   values=["priority","job"]
 }

 stage.static_labels {
   values = {
     category="system",
     service_name="kernel",
   }
 }
}



// =============================================================================
// PULL LEGADO — node_exporter + mysqld_exporter remoto
//
// Coleta métricas de SO (node) e banco de dados (mysql) via scrape HTTP direto.
// Indicado para servidores legados onde não é possível instalar o Alloy agent.
//
// Como usar:
//   Copie este arquivo para alloy-gateway/conf.d/ e reinicie o Alloy Gateway.
//   Adicione um bloco por servidor nas listas targets abaixo.
// =============================================================================

// -----------------------------------------------------------------------------
// NODE METRICS
// -----------------------------------------------------------------------------
prometheus.scrape "linux_mysql_node" {
  targets = [
    {
      "__address__"             = "192.168.1.13:8180",
      "__metrics_path__"        = "/node/metrics",
      "instance"                = "srv-mysql-01",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "192.168.10.57:8080",
    //   "__metrics_path__"        = "/node/metrics",
    //   "instance"                = "srv-mysql-02",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "linux-node"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.linux_mysql_node_transformer.receiver]
}

prometheus.relabel "linux_mysql_node_transformer" {
  forward_to = [prometheus.relabel.linux_mysql_node_host_info.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         =
      // Core & Metadata
      "node_boot_time_seconds|" +
      "node_uname_info|" +
      "node_os_info|" +

      // CPU & Load
      "node_cpu_seconds_total|" +
      "node_load1|" +
      "node_load5|" +
      "node_load15|" +

      // Memory
      "node_memory_Buffers_bytes|" +
      "node_memory_Cached_bytes|" +
      "node_memory_MemAvailable_bytes|" +
      "node_memory_MemFree_bytes|" +
      "node_memory_MemTotal_bytes|" +
      "node_memory_SReclaimable_bytes|" +
      "node_memory_SwapFree_bytes|" +
      "node_memory_SwapTotal_bytes|" +

      // System Pressure
      "node_pressure_cpu.*|" +
      "node_pressure_io.*|" +
      "node_pressure_memory.*|" +

      // Disk & Filesystem
      "node_disk_read.*|" +
      "node_disk_write.*|" +
      "node_disk_written.*|" +
      "node_disk_io_time.*|" +
      "node_filesystem_avail_bytes|" +
      "node_filesystem_files|" +
      "node_filesystem_files_free|" +
      "node_filesystem_free_bytes|" +
      "node_filesystem_size_bytes|" +

      // Network
      "node_network_receive_bytes_total|" +
      "node_network_receive_drop_total|" +
      "node_network_receive_errs_total|" +
      "node_network_speed_bytes|" +
      "node_network_transmit_bytes_total|" +
      "node_network_transmit_drop_total|" +
      "node_network_transmit_errs_total"
  }

  rule {
    source_labels = ["device"]
    regex         = "^(loop|ram|fd|sr)[0-9]*$|^dm-[0-9]+$"
    action        = "drop"
  }

  rule {
    target_label = "service_name"
    replacement  = "node-exporter"
  }
}

prometheus.relabel "linux_mysql_node_host_info" {
  forward_to = [prometheus.remote_write.linux_mysql_gateway.receiver]

  // Para node_uname_info: sysname → os (lowercase)
  rule {
    source_labels = ["__name__", "sysname"]
    regex         = "node_uname_info;(.*)"
    target_label  = "os"
    replacement   = "$1"
  }

  rule {
    source_labels = ["os"]
    target_label  = "os"
    action        = "lowercase"
  }

  // Para node_uname_info: machine → architecture
  rule {
    source_labels = ["__name__", "machine"]
    regex         = "node_uname_info;(.*)"
    target_label  = "architecture"
    replacement   = "$1"
  }

  // Para node_uname_info: release → kernel_release
  rule {
    source_labels = ["__name__", "release"]
    regex         = "node_uname_info;(.*)"
    target_label  = "kernel_release"
    replacement   = "$1"
  }

  // Para node_os_info: name → os_product
  rule {
    source_labels = ["__name__", "name"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_product"
    replacement   = "$1"
  }

  // Para node_os_info: version_id → os_version
  rule {
    source_labels = ["__name__", "version_id"]
    regex         = "node_os_info;(.*)"
    target_label  = "os_version"
    replacement   = "$1"
  }
}

// -----------------------------------------------------------------------------
// MYSQL METRICS
// -----------------------------------------------------------------------------
prometheus.scrape "linux_mysql_db" {
  targets = [
    {
      "__address__"             = "192.168.1.13:8180",
      "__metrics_path__"        = "/mysql/metrics",
      "instance"                = "srv-mysql-01",
      "environment"             = "prd",
      "cloud_provider"          = "mgc",
      "cloud_region"            = "br-se1",
      "cloud_availability_zone" = "a",
    },
    // {
    //   "__address__"             = "192.168.10.57:8080",
    //   "__metrics_path__"        = "/mysql/metrics",
    //   "instance"                = "srv-mysql-02",
    //   "environment"             = "prd",
    //   "cloud_provider"          = "mgc",
    //   "cloud_region"            = "br-se1",
    //   "cloud_availability_zone" = "a",
    // },
  ]

  job_name        = "linux-mysql"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.relabel.linux_mysql_db_transformer.receiver]
}

prometheus.relabel "linux_mysql_db_transformer" {
  forward_to = [prometheus.remote_write.linux_mysql_gateway.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         =
      // Status & Connection
      "mysql_up|" +
      "mysql_global_variables_max_connections|" +
      "mysql_global_status_threads_connected|" +
      "mysql_global_status_threads_running|" +
      "mysql_global_status_connections|" +
      "mysql_global_status_threads_created|" +

      // Storage & Replication
      "mysql_binlog_size_bytes|" +
      "mysql_global_status_innodb_redo_log_physical_size|" +
      "mysql_global_status_innodb_redo_log_logical_size|" +

      // Temp Storage
      "mysql_global_status_created_tmp_disk_tables|" +
      "mysql_global_status_created_tmp_files|" +
      "mysql_global_status_created_tmp_tables|" +

      // Transaction Activity
      "mysql_global_status_questions|" +
      "mysql_global_status_queries|" +
      "mysql_global_status_commands_total|" +

      // Row Operations (InnoDB)
      "mysql_global_status_innodb_system_rows_read|" +
      "mysql_global_status_innodb_system_rows_inserted|" +
      "mysql_global_status_innodb_system_rows_updated|" +
      "mysql_global_status_innodb_system_rows_deleted|" +

      // InnoDB Buffer Pool & Data
      "mysql_global_status_innodb_buffer_pool_bytes_data|" +
      "mysql_global_status_innodb_buffer_pool_bytes_dirty|" +
      "mysql_global_status_innodb_buffer_pool_read_requests|" +
      "mysql_global_status_innodb_buffer_pool_reads|" +
      "mysql_global_status_innodb_buffer_pool_write_requests|" +
      "mysql_global_status_innodb_pages_read|" +
      "mysql_global_status_innodb_pages_written|" +

      // I/O Operations
      "mysql_global_status_innodb_data_reads|" +
      "mysql_global_status_innodb_data_writes|" +
      "mysql_global_status_innodb_data_read|" +
      "mysql_global_status_innodb_data_written|" +

      // Locking & Conflicts
      "mysql_global_status_innodb_row_lock_waits|" +
      "mysql_global_status_innodb_row_lock_time|" +
      "mysql_global_status_table_locks_waited|" +
      "mysql_global_status_table_locks_immediate|" +

      // Network
      "mysql_global_status_bytes_received|" +
      "mysql_global_status_bytes_sent|" +

      // Other
      "mysql_global_status_uptime"
  }

  rule {
    target_label = "service_name"
    replacement  = "mysqld-exporter"
  }
}

// -----------------------------------------------------------------------------
// REMOTE WRITE
// -----------------------------------------------------------------------------
prometheus.remote_write "linux_mysql_gateway" {
  endpoint { url = "http://alloy-gateway:9999/api/v1/metrics/write" }
}

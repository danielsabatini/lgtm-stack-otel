// =============================================================================
// OTLP — Applications Ingestion Pipeline
// =============================================================================
// Pipeline: apps -> receiver -> limiter -> sampling (traces) -> batch -> outputs
// =============================================================================

otelcol.receiver.otlp "apps" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces  = [otelcol.processor.memory_limiter.apps.input]
    metrics = [otelcol.processor.memory_limiter.apps.input]
    logs    = [otelcol.processor.memory_limiter.apps.input]
  }
}


// =============================================================================
// PROCESSORS
// =============================================================================

otelcol.processor.memory_limiter "apps" {
  check_interval = "1s"
  limit          = "1GiB"
  spike_limit    = "200MiB"

  output {
    traces  = [otelcol.processor.tail_sampling.apps_traces.input]
    metrics = [otelcol.processor.batch.apps.input]
    logs    = [otelcol.processor.batch.apps.input]
  }
}


otelcol.processor.tail_sampling "apps_traces" {
  decision_wait = "10s"
  num_traces    = 50000

  policy {
    name = "keep-errors"
    type = "status_code"
    status_code { status_codes = ["ERROR"] }
  }

  policy {
    name = "keep-slow"
    type = "latency"
    latency { threshold_ms = 1000 }
  }

  policy {
    name = "sample-ok"
    type = "probabilistic"
    probabilistic { sampling_percentage = 5 }
  }

  output {
    traces = [otelcol.processor.batch.apps.input]
  }
}


otelcol.processor.batch "apps" {
  send_batch_size = 2000
  timeout         = "5s"

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.loki.loki.input]
  }
}
// =============================================================================
// LOGS — Gateway Ingestion (Agent -> Gateway -> Loki)
// =============================================================================
// Recebe logs enviados pelos alloy-agents via HTTP.
// Pipeline: agents -> loki.source.api -> 999-outputs (Loki)
// =============================================================================

loki.source.api "logs" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9998
  }

  forward_to = [
    loki.write.loki.receiver,
  ]
}
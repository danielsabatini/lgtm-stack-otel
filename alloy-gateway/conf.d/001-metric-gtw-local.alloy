// =============================================================================
// METRICS — Gateway Ingestion (Agent -> Gateway -> Mimir)
// =============================================================================
// Recebe métricas enviadas pelos alloy-agents via HTTP remote write.
// Pipeline: agents -> receive_http -> 999-outputs (Mimir)
// =============================================================================

prometheus.receive_http "metrics" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }

  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]
}
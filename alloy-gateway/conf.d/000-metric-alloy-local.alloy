// =============================================================================
// METRICS — Alloy Gateway Self Monitoring
// =============================================================================
// Pipeline: self_exporter -> scrape -> transformer -> 999-outputs (Mimir)
// =============================================================================

prometheus.exporter.self "alloy_gateway_exporter" {}


prometheus.scrape "alloy_gateway_scrape" {
  targets    = prometheus.exporter.self.alloy_gateway_exporter.targets
  forward_to = [prometheus.relabel.alloy_gateway_transformer.receiver]

  job_name        = "alloy-gateway"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}


prometheus.relabel "alloy_gateway_transformer" {
  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]

  // Keep only Alloy self metrics (Descomente apenas para Debug/Troubleshooting)
  /*
  rule {
    source_labels = ["__name__"]
    regex         = "alloy_.+"
    action        = "keep"
  }
  */
}
// =============================================================================
// GLOBAL OUTPUTS — Mimir, Loki and Tempo Endpoints
// =============================================================================
// This file centralizes all outgoing traffic from the Gateway.
// Todos os sinais saem em OTLP nativo (sem prometheus.remote_write/loki.write).
// =============================================================================

// -----------------------------------------------------------------------------
// METRICS — OTLP nativo (Mimir /otlp/v1/metrics)
// -----------------------------------------------------------------------------
// Nomes e atributos preservados na OTel Semantic Conventions (ver limits.otel_*
// em mimir/mimir.yaml).
otelcol.exporter.otlphttp "mimir" {
  client {
    endpoint = "http://mimir:9009/otlp"
  }
}


// -----------------------------------------------------------------------------
// LOGS — OTLP nativo (Loki /otlp/v1/logs)
// -----------------------------------------------------------------------------
// Resource attributes -> index labels / structured metadata conforme
// limits_config.otlp_config em loki/loki.yaml.
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}


// -----------------------------------------------------------------------------
// TRACES — OTLP nativo (Tempo)
// -----------------------------------------------------------------------------
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

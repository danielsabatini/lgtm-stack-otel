    subgraph TELEMETRY ["📡 1. Fontes de Telemetria Contínua"]
        MIMIR[("📈 Métricas (Mimir)<br/>Taxa de erros, latência p99, saturação")]:::srcBox
        LOKI[("📜 Logs (Loki)<br/>Exceções críticas, panics, falhas de auth")]:::srcBox

# =============================================================================
# Copie este arquivo para .env e ajuste os valores antes de subir o stack.
# Os defaults definidos aqui são usados quando a variável não está presente.
# =============================================================================

# --- Versões de Software (Lifecycle/Orquestração) ---
# IMPORTANTE: Consulte o UPGRADE.md antes de alterar qualquer TSDB.
GRAFANA_VERSION=13.1.2
GRAFANA_ALLOY_VERSION=v1.16.0
GRAFANA_LOKI_VERSION=3.7.1
GRAFANA_MIMIR_VERSION=3.0.6
GRAFANA_TEMPO_VERSION=2.10.5

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# --- Identificação do Host (Alloy Agent) ---
# Usado para enriquecer métricas e logs com contexto de infraestrutura,
# garantindo correlação entre os sinais no Grafana.
ENVIRONMENT=prd
CLOUD_PROVIDER=mgc
CLOUD_REGION=br-se1
CLOUD_AVAILABILITY_ZONE=a

# --- Retenção de dados ---
# Loki (logs) e Mimir (métricas): formato aceito: 24h, 7d, 30d, 1y
# Tempo (traces): apenas horas — formato aceito: 24h, 168h, 336h
LOKI_RETENTION=30d
MIMIR_RETENTION=30d
TEMPO_RETENTION=336h

# --- Limites de Recursos (Dimensionados para Máquina de 8 vCPU e 32 GB RAM) ---
# Teto máximo alocado pelos contêineres. O total consumido pelos valores default
# abaixo é de 8 vCPUs e 28 GB RAM (Reservando 4GB essenciais para o Host Linux).
LOKI_CPUS=2.0
LOKI_MEMORY=6GB

MIMIR_CPUS=2.0
MIMIR_MEMORY=8GB

TEMPO_CPUS=2.0
TEMPO_MEMORY=6GB

GRAFANA_CPUS=1.0
GRAFANA_MEMORY=4GB

ALLOY_GATEWAY_CPUS=1.0
ALLOY_GATEWAY_MEMORY=2GB

ALLOY_AGENT_CPUS=0.5
ALLOY_AGENT_MEMORY=1GB
